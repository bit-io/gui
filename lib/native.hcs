native {Rust} [
pub mod paint {
    use std::cell::RefCell;
    use std::collections::HashMap;
    use std::rc::Rc;
    use tiny_skia::{
        BlendMode, Color, FillRule, GradientStop, LineCap, LineJoin, LinearGradient, Mask, MaskType,
        Paint, Path, PathBuilder, Pixmap, PixmapMut, PixmapPaint, Point, RadialGradient, Rect,
        SpreadMode, Stroke, Transform,
    };

    pub const OP_RRECT: i64 = 1;
    pub const OP_STROKE: i64 = 2;
    pub const OP_LGRAD: i64 = 3;
    pub const OP_RGRAD: i64 = 4;
    pub const OP_SHADOW: i64 = 5;
    pub const OP_TEXT: i64 = 6;
    pub const OP_CLIP: i64 = 7;
    pub const OP_UNCLIP: i64 = 8;
    pub const OP_ICON: i64 = 9;
    pub const OP_BACKDROP: i64 = 10;
    pub const OP_LAYER: i64 = 11;
    pub const OP_ENDLAYER: i64 = 12;
    pub const OP_LINE: i64 = 13;
    pub const OP_PATH: i64 = 14;
    pub const OP_CLEAR: i64 = 15;

    pub fn b64_decode(s: &str) -> Vec<u8> {
        let mut out: Vec<u8> = Vec::with_capacity(s.len() * 3 / 4);
        let mut acc: u32 = 0;
        let mut bits: u32 = 0;
        for ch in s.bytes() {
            let v: u32 = match ch {
                b'A'..=b'Z' => (ch - b'A') as u32,
                b'a'..=b'z' => (ch - b'a') as u32 + 26,
                b'0'..=b'9' => (ch - b'0') as u32 + 52,
                b'+' => 62,
                b'/' => 63,
                _ => continue,
            };
            acc = (acc << 6) | v;
            bits += 6;
            if bits >= 8 {
                bits -= 8;
                out.push(((acc >> bits) & 0xff) as u8);
            }
        }
        out
    }

    pub struct Face {
        pub face: ttf_parser::Face<'static>,
        pub upem: f32,
        pub ascent: f32,
        pub descent: f32,
        pub cmap_cache: HashMap<char, u16>,
    }

    pub struct Glyph {
        pub w: u32,
        pub h: u32,
        pub left: i32,
        pub top: i32,
        pub data: Vec<u8>,
    }

    pub struct Fonts {
        pub faces: Vec<Face>,
        pub glyphs: HashMap<(u8, u16, u32, u8), Rc<Glyph>>,
        pub icons: HashMap<String, Rc<Vec<Path>>>,
        pub icon_src: HashMap<String, String>,
    }

    thread_local! {
        pub static FONTS: RefCell<Fonts> = RefCell::new(Fonts { faces: Vec::new(), glyphs: HashMap::new(), icons: HashMap::new(), icon_src: HashMap::new() });
    }

    pub fn add_face(bytes: Vec<u8>) -> i64 {
        let leaked: &'static [u8] = Box::leak(bytes.into_boxed_slice());
        match ttf_parser::Face::parse(leaked, 0) {
            Ok(f) => {
                let upem = f.units_per_em() as f32;
                let asc = f.ascender() as f32 / upem;
                let desc = f.descender() as f32 / upem;
                FONTS.with(|fo| {
                    let mut fo = fo.borrow_mut();
                    fo.faces.push(Face { face: f, upem, ascent: asc, descent: desc, cmap_cache: HashMap::new() });
                    (fo.faces.len() as i64) - 1
                })
            }
            Err(_) => -1,
        }
    }

    pub fn add_icons(table: &str) {
        FONTS.with(|fo| {
            let mut fo = fo.borrow_mut();
            for line in table.lines() {
                if let Some(p) = line.find('|') {
                    fo.icon_src.insert(line[..p].trim().to_string(), line[p + 1..].trim().to_string());
                }
            }
        });
    }

    fn glyph_id(f: &mut Face, c: char) -> u16 {
        if let Some(g) = f.cmap_cache.get(&c) {
            return *g;
        }
        let g = f.face.glyph_index(c).map(|g| g.0).unwrap_or(0);
        f.cmap_cache.insert(c, g);
        g
    }

    fn face_for(fo: &mut Fonts, weight: i64, c: char) -> (usize, u16) {
        let n = fo.faces.len();
        if n == 0 {
            return (0, 0);
        }
        let pref = if weight >= 1 && n > 1 { 1 } else { 0 };
        let g = glyph_id(&mut fo.faces[pref], c);
        if g != 0 || c == ' ' {
            return (pref, g);
        }
        for i in 0..n {
            if i == pref {
                continue;
            }
            let g2 = glyph_id(&mut fo.faces[i], c);
            if g2 != 0 {
                return (i, g2);
            }
        }
        (pref, 0)
    }

    fn kern_pair(f: &Face, a: u16, b: u16) -> f32 {
        use ttf_parser::gpos::PairAdjustment;
        use ttf_parser::GlyphId;
        let gpos = match f.face.tables().gpos {
            Some(g) => g,
            None => return 0.0,
        };
        let ga = GlyphId(a);
        let gb = GlyphId(b);
        for li in 0..gpos.lookups.len() {
            let lookup = match gpos.lookups.get(li) {
                Some(l) => l,
                None => continue,
            };
            for si in 0..lookup.subtables.len() {
                let st = match lookup.subtables.get::<ttf_parser::gpos::PositioningSubtable>(si) {
                    Some(s) => s,
                    None => continue,
                };
                if let ttf_parser::gpos::PositioningSubtable::Pair(p) = st {
                    match p {
                        PairAdjustment::Format1 { coverage, sets } => {
                            if let Some(ci) = coverage.get(ga) {
                                if let Some(set) = sets.get(ci) {
                                    if let Some((v1, _v2)) = set.get(gb) {
                                        if v1.x_advance != 0 {
                                            return v1.x_advance as f32 / f.upem;
                                        }
                                    }
                                }
                            }
                        }
                        PairAdjustment::Format2 { coverage, classes, matrix } => {
                            if coverage.get(ga).is_some() {
                                let c1 = classes.0.get(ga);
                                let c2 = classes.1.get(gb);
                                if let Some((v1, _v2)) = matrix.get((c1, c2)) {
                                    if v1.x_advance != 0 {
                                        return v1.x_advance as f32 / f.upem;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if li > 6 {
                break;
            }
        }
        0.0
    }

    pub fn measure_text(text: &str, size: f32, weight: i64, ls: f32) -> f32 {
        FONTS.with(|fo| {
            let mut fo = fo.borrow_mut();
            let mut x = 0.0f32;
            let mut prev: Option<(usize, u16)> = None;
            for c in text.chars() {
                let (fi, g) = face_for(&mut fo, weight, c);
                if fo.faces.is_empty() {
                    x += size * 0.55;
                    continue;
                }
                let face = &fo.faces[fi];
                if let Some((pf, pg)) = prev {
                    if pf == fi {
                        x += kern_pair(face, pg, g) * size;
                    }
                }
                let adv = face.face.glyph_hor_advance(ttf_parser::GlyphId(g)).unwrap_or(0) as f32 / face.upem;
                x += adv * size + ls;
                prev = Some((fi, g));
            }
            x
        })
    }

    pub fn font_metrics(size: f32, weight: i64) -> (f32, f32) {
        FONTS.with(|fo| {
            let fo = fo.borrow();
            let i = if weight >= 1 && fo.faces.len() > 1 { 1 } else { 0 };
            if fo.faces.is_empty() {
                return (size * 0.95, size * 0.25);
            }
            (fo.faces[i].ascent * size, -fo.faces[i].descent * size)
        })
    }

    pub fn wrap_text(text: &str, size: f32, weight: i64, max_w: f32, ls: f32) -> Vec<String> {
        let max_w = if max_w > 0.0 { max_w + 1.0 } else { max_w };
        let mut lines: Vec<String> = Vec::new();
        for para in text.split('\n') {
            if max_w <= 0.0 {
                lines.push(para.to_string());
                continue;
            }
            let mut cur = String::new();
            let mut cur_w = 0.0f32;
            let space_w = measure_text(" ", size, weight, ls);
            for word in para.split(' ') {
                let ww = measure_text(word, size, weight, ls);
                if cur.is_empty() {
                    if ww <= max_w {
                        cur.push_str(word);
                        cur_w = ww;
                    } else {
                        let mut piece = String::new();
                        let mut pw = 0.0f32;
                        for ch in word.chars() {
                            let cw = measure_text(&ch.to_string(), size, weight, ls);
                            if pw + cw > max_w && !piece.is_empty() {
                                lines.push(piece.clone());
                                piece.clear();
                                pw = 0.0;
                            }
                            piece.push(ch);
                            pw += cw;
                        }
                        cur = piece;
                        cur_w = pw;
                    }
                } else if cur_w + space_w + ww <= max_w {
                    cur.push(' ');
                    cur.push_str(word);
                    cur_w += space_w + ww;
                } else {
                    lines.push(cur.clone());
                    cur.clear();
                    if ww <= max_w {
                        cur.push_str(word);
                        cur_w = ww;
                    } else {
                        let mut piece = String::new();
                        let mut pw = 0.0f32;
                        for ch in word.chars() {
                            let cw = measure_text(&ch.to_string(), size, weight, ls);
                            if pw + cw > max_w && !piece.is_empty() {
                                lines.push(piece.clone());
                                piece.clear();
                                pw = 0.0;
                            }
                            piece.push(ch);
                            pw += cw;
                        }
                        cur = piece;
                        cur_w = pw;
                    }
                }
            }
            lines.push(cur);
        }
        lines
    }

    struct OutlineSink {
        pb: PathBuilder,
        s: f32,
        ox: f32,
        oy: f32,
    }
    impl ttf_parser::OutlineBuilder for OutlineSink {
        fn move_to(&mut self, x: f32, y: f32) {
            self.pb.move_to(self.ox + x * self.s, self.oy - y * self.s);
        }
        fn line_to(&mut self, x: f32, y: f32) {
            self.pb.line_to(self.ox + x * self.s, self.oy - y * self.s);
        }
        fn quad_to(&mut self, x1: f32, y1: f32, x: f32, y: f32) {
            self.pb.quad_to(self.ox + x1 * self.s, self.oy - y1 * self.s, self.ox + x * self.s, self.oy - y * self.s);
        }
        fn curve_to(&mut self, x1: f32, y1: f32, x2: f32, y2: f32, x: f32, y: f32) {
            self.pb.cubic_to(
                self.ox + x1 * self.s,
                self.oy - y1 * self.s,
                self.ox + x2 * self.s,
                self.oy - y2 * self.s,
                self.ox + x * self.s,
                self.oy - y * self.s,
            );
        }
        fn close(&mut self) {
            self.pb.close();
        }
    }

    fn raster_glyph(fo: &mut Fonts, fi: usize, gid: u16, size_px: f32, sub: u8) -> Option<Rc<Glyph>> {
        let key = (fi as u8, gid, (size_px * 4.0) as u32, sub);
        if let Some(g) = fo.glyphs.get(&key) {
            return Some(g.clone());
        }
        let face = &fo.faces[fi];
        let s = size_px / face.upem;
        let bb = face.face.glyph_bounding_box(ttf_parser::GlyphId(gid));
        let g = match bb {
            Some(bb) => {
                let fx = sub as f32 / 4.0;
                let x0 = (bb.x_min as f32 * s + fx).floor() as i32 - 1;
                let x1 = (bb.x_max as f32 * s + fx).ceil() as i32 + 1;
                let y0 = (-(bb.y_max as f32) * s).floor() as i32 - 1;
                let y1 = (-(bb.y_min as f32) * s).ceil() as i32 + 1;
                let w = (x1 - x0).max(1) as u32;
                let h = (y1 - y0).max(1) as u32;
                let mut sink = OutlineSink { pb: PathBuilder::new(), s, ox: fx - x0 as f32, oy: -(y0 as f32) };
                face.face.outline_glyph(ttf_parser::GlyphId(gid), &mut sink)?;
                let path = sink.pb.finish()?;
                let mut pm = Pixmap::new(w, h)?;
                let mut paint = Paint::default();
                paint.set_color_rgba8(255, 255, 255, 255);
                paint.anti_alias = true;
                pm.fill_path(&path, &paint, FillRule::Winding, Transform::identity(), None);
                let data: Vec<u8> = pm.data().chunks(4).map(|p| p[3]).collect();
                Glyph { w, h, left: x0, top: y0, data }
            }
            None => Glyph { w: 0, h: 0, left: 0, top: 0, data: Vec::new() },
        };
        let rc = Rc::new(g);
        fo.glyphs.insert(key, rc.clone());
        Some(rc)
    }

    #[inline]
    pub fn col(c: f64) -> Color {
        let c = c as u32;
        Color::from_rgba8(((c >> 8) & 255) as u8, ((c >> 16) & 255) as u8, ((c >> 24) & 255) as u8, (c & 255) as u8)
    }

    fn rrect_path(x: f32, y: f32, w: f32, h: f32, r: [f32; 4]) -> Option<Path> {
        let maxr = (w.min(h)) / 2.0;
        let r = [r[0].min(maxr).max(0.0), r[1].min(maxr).max(0.0), r[2].min(maxr).max(0.0), r[3].min(maxr).max(0.0)];
        let k = 0.5522847498f32;
        let mut pb = PathBuilder::new();
        pb.move_to(x + r[0], y);
        pb.line_to(x + w - r[1], y);
        if r[1] > 0.0 {
            pb.cubic_to(x + w - r[1] + r[1] * k, y, x + w, y + r[1] - r[1] * k, x + w, y + r[1]);
        }
        pb.line_to(x + w, y + h - r[2]);
        if r[2] > 0.0 {
            pb.cubic_to(x + w, y + h - r[2] + r[2] * k, x + w - r[2] + r[2] * k, y + h, x + w - r[2], y + h);
        }
        pb.line_to(x + r[3], y + h);
        if r[3] > 0.0 {
            pb.cubic_to(x + r[3] - r[3] * k, y + h, x, y + h - r[3] + r[3] * k, x, y + h - r[3]);
        }
        pb.line_to(x, y + r[0]);
        if r[0] > 0.0 {
            pb.cubic_to(x, y + r[0] - r[0] * k, x + r[0] - r[0] * k, y, x + r[0], y);
        }
        pb.close();
        pb.finish()
    }

    fn parse_svg_path(d: &str) -> Option<Path> {
        let b: Vec<char> = d.chars().collect();
        let mut i = 0usize;
        let mut pb = PathBuilder::new();
        let (mut cx, mut cy) = (0.0f32, 0.0f32);
        let (mut sx, mut sy) = (0.0f32, 0.0f32);
        let (mut lcx, mut lcy) = (0.0f32, 0.0f32); // ostatni punkt kontrolny
        let mut cmd = 'M';
        let mut prev_cmd = 'M';
        let mut started = false;

        fn skip(b: &Vec<char>, i: &mut usize) {
            while *i < b.len() && (b[*i] == ' ' || b[*i] == ',' || b[*i] == '\n' || b[*i] == '\t') {
                *i += 1;
            }
        }
        fn num(b: &Vec<char>, i: &mut usize) -> Option<f32> {
            skip(b, i);
            let st = *i;
            if *i < b.len() && (b[*i] == '-' || b[*i] == '+') {
                *i += 1;
            }
            let mut dot = false;
            while *i < b.len() {
                let c = b[*i];
                if c.is_ascii_digit() {
                    *i += 1;
                } else if c == '.' && !dot {
                    dot = true;
                    *i += 1;
                } else if (c == 'e' || c == 'E') && *i > st {
                    *i += 1;
                    if *i < b.len() && (b[*i] == '-' || b[*i] == '+') {
                        *i += 1;
                    }
                } else {
                    break;
                }
            }
            if *i == st {
                return None;
            }
            b[st..*i].iter().collect::<String>().parse::<f32>().ok()
        }
        fn flag(b: &Vec<char>, i: &mut usize) -> Option<bool> {
            skip(b, i);
            if *i < b.len() && (b[*i] == '0' || b[*i] == '1') {
                let v = b[*i] == '1';
                *i += 1;
                Some(v)
            } else {
                None
            }
        }

        loop {
            skip(&b, &mut i);
            if i >= b.len() {
                break;
            }
            let c = b[i];
            if c.is_ascii_alphabetic() {
                cmd = c;
                i += 1;
                if cmd == 'z' || cmd == 'Z' {
                    pb.close();
                    cx = sx;
                    cy = sy;
                    prev_cmd = 'Z';
                    continue;
                }
            } else if cmd == 'M' {
                cmd = 'L';
            } else if cmd == 'm' {
                cmd = 'l';
            }
            let rel = cmd.is_ascii_lowercase();
            let up = cmd.to_ascii_uppercase();
            let (ox, oy) = if rel { (cx, cy) } else { (0.0, 0.0) };
            match up {
                'M' => {
                    let x = num(&b, &mut i)? + ox;
                    let y = num(&b, &mut i)? + oy;
                    pb.move_to(x, y);
                    cx = x;
                    cy = y;
                    sx = x;
                    sy = y;
                    started = true;
                }
                'L' => {
                    let x = num(&b, &mut i)? + ox;
                    let y = num(&b, &mut i)? + oy;
                    pb.line_to(x, y);
                    cx = x;
                    cy = y;
                }
                'H' => {
                    let x = num(&b, &mut i)? + ox;
                    pb.line_to(x, cy);
                    cx = x;
                }
                'V' => {
                    let y = num(&b, &mut i)? + oy;
                    pb.line_to(cx, y);
                    cy = y;
                }
                'C' => {
                    let x1 = num(&b, &mut i)? + ox;
                    let y1 = num(&b, &mut i)? + oy;
                    let x2 = num(&b, &mut i)? + ox;
                    let y2 = num(&b, &mut i)? + oy;
                    let x = num(&b, &mut i)? + ox;
                    let y = num(&b, &mut i)? + oy;
                    pb.cubic_to(x1, y1, x2, y2, x, y);
                    lcx = x2;
                    lcy = y2;
                    cx = x;
                    cy = y;
                }
                'S' => {
                    let x2 = num(&b, &mut i)? + ox;
                    let y2 = num(&b, &mut i)? + oy;
                    let x = num(&b, &mut i)? + ox;
                    let y = num(&b, &mut i)? + oy;
                    let (x1, y1) = if prev_cmd == 'C' || prev_cmd == 'S' { (2.0 * cx - lcx, 2.0 * cy - lcy) } else { (cx, cy) };
                    pb.cubic_to(x1, y1, x2, y2, x, y);
                    lcx = x2;
                    lcy = y2;
                    cx = x;
                    cy = y;
                }
                'Q' => {
                    let x1 = num(&b, &mut i)? + ox;
                    let y1 = num(&b, &mut i)? + oy;
                    let x = num(&b, &mut i)? + ox;
                    let y = num(&b, &mut i)? + oy;
                    pb.quad_to(x1, y1, x, y);
                    lcx = x1;
                    lcy = y1;
                    cx = x;
                    cy = y;
                }
                'T' => {
                    let x = num(&b, &mut i)? + ox;
                    let y = num(&b, &mut i)? + oy;
                    let (x1, y1) = if prev_cmd == 'Q' || prev_cmd == 'T' { (2.0 * cx - lcx, 2.0 * cy - lcy) } else { (cx, cy) };
                    pb.quad_to(x1, y1, x, y);
                    lcx = x1;
                    lcy = y1;
                    cx = x;
                    cy = y;
                }
                'A' => {
                    let rx = num(&b, &mut i)?;
                    let ry = num(&b, &mut i)?;
                    let rot = num(&b, &mut i)?;
                    let large = flag(&b, &mut i)?;
                    let sweep = flag(&b, &mut i)?;
                    let x = num(&b, &mut i)? + ox;
                    let y = num(&b, &mut i)? + oy;
                    arc_to(&mut pb, cx, cy, rx, ry, rot, large, sweep, x, y);
                    cx = x;
                    cy = y;
                }
                _ => return None,
            }
            prev_cmd = up;
        }
        if !started {
            return None;
        }
        pb.finish()
    }

    fn arc_to(pb: &mut PathBuilder, x1: f32, y1: f32, rx: f32, ry: f32, rot_deg: f32, large: bool, sweep: bool, x2: f32, y2: f32) {
        if (x1 - x2).abs() < 1e-6 && (y1 - y2).abs() < 1e-6 {
            return;
        }
        let mut rx = rx.abs();
        let mut ry = ry.abs();
        if rx < 1e-6 || ry < 1e-6 {
            pb.line_to(x2, y2);
            return;
        }
        let phi = rot_deg.to_radians();
        let (sp, cp) = phi.sin_cos();
        let dx = (x1 - x2) / 2.0;
        let dy = (y1 - y2) / 2.0;
        let x1p = cp * dx + sp * dy;
        let y1p = -sp * dx + cp * dy;
        let lam = (x1p * x1p) / (rx * rx) + (y1p * y1p) / (ry * ry);
        if lam > 1.0 {
            let s = lam.sqrt();
            rx *= s;
            ry *= s;
        }
        let num = rx * rx * ry * ry - rx * rx * y1p * y1p - ry * ry * x1p * x1p;
        let den = rx * rx * y1p * y1p + ry * ry * x1p * x1p;
        let mut co = if den == 0.0 { 0.0 } else { (num / den).max(0.0).sqrt() };
        if large == sweep {
            co = -co;
        }
        let cxp = co * rx * y1p / ry;
        let cyp = -co * ry * x1p / rx;
        let cx = cp * cxp - sp * cyp + (x1 + x2) / 2.0;
        let cy = sp * cxp + cp * cyp + (y1 + y2) / 2.0;
        let ang = |ux: f32, uy: f32, vx: f32, vy: f32| -> f32 {
            let dot = ux * vx + uy * vy;
            let len = (ux * ux + uy * uy).sqrt() * (vx * vx + vy * vy).sqrt();
            let mut a = (dot / len).clamp(-1.0, 1.0).acos();
            if ux * vy - uy * vx < 0.0 {
                a = -a;
            }
            a
        };
        let th1 = ang(1.0, 0.0, (x1p - cxp) / rx, (y1p - cyp) / ry);
        let mut dth = ang((x1p - cxp) / rx, (y1p - cyp) / ry, (-x1p - cxp) / rx, (-y1p - cyp) / ry);
        if !sweep && dth > 0.0 {
            dth -= std::f32::consts::TAU;
        } else if sweep && dth < 0.0 {
            dth += std::f32::consts::TAU;
        }
        let segs = (dth.abs() / (std::f32::consts::FRAC_PI_2)).ceil().max(1.0) as i32;
        let delta = dth / segs as f32;
        let t = 4.0 / 3.0 * (delta / 4.0).tan();
        let mut a = th1;
        for _ in 0..segs {
            let (s1, c1) = a.sin_cos();
            let (s2, c2) = (a + delta).sin_cos();
            let p1x = c1 - t * s1;
            let p1y = s1 + t * c1;
            let p2x = c2 + t * s2;
            let p2y = s2 - t * c2;
            let map = |px: f32, py: f32| -> (f32, f32) {
                let xx = px * rx;
                let yy = py * ry;
                (cp * xx - sp * yy + cx, sp * xx + cp * yy + cy)
            };
            let (c1x, c1y) = map(p1x, p1y);
            let (c2x, c2y) = map(p2x, p2y);
            let (ex, ey) = map(c2, s2);
            pb.cubic_to(c1x, c1y, c2x, c2y, ex, ey);
            a += delta;
        }
    }

    fn box_blur_pass(src: &[u8], dst: &mut [u8], w: usize, h: usize, ch: usize, r: usize, horizontal: bool) {
        if r == 0 {
            dst.copy_from_slice(src);
            return;
        }
        let (n_lines, len, stride_line, stride_el) = if horizontal { (h, w, w * ch, ch) } else { (w, h, ch, w * ch) };
        let div = (2 * r + 1) as i64;
        let last = len as i64 - 1;
        for line in 0..n_lines {
            let base = line * stride_line;
            for c in 0..ch {
                let at = |k: i64| -> i64 {
                    let kk = k.max(0).min(last) as usize;
                    src[base + kk * stride_el + c] as i64
                };
                let mut acc: i64 = 0;
                for k in -(r as i64)..=(r as i64) {
                    acc += at(k);
                }
                for i in 0..len as i64 {
                    dst[base + (i as usize) * stride_el + c] = (acc / div) as u8;
                    acc += at(i + r as i64 + 1) - at(i - r as i64);
                }
            }
        }
    }

    pub fn gaussian_blur(buf: &mut Vec<u8>, w: usize, h: usize, ch: usize, sigma: f32) {
        if sigma < 0.3 || w == 0 || h == 0 {
            return;
        }
        let b = ((12.0 * sigma * sigma / 3.0 + 1.0).sqrt()).floor().max(1.0) as usize;
        let r = (b - 1) / 2;
        let mut tmp = vec![0u8; buf.len()];
        for _ in 0..3 {
            box_blur_pass(buf, &mut tmp, w, h, ch, r.max(1), true);
            box_blur_pass(&tmp, buf, w, h, ch, r.max(1), false);
        }
    }

    pub struct Painter<'a> {
        base: &'a mut [u8],
        pub w: u32,
        pub h: u32,
        pub scale: f32,
        layers: Vec<(Pixmap, f32)>,
        clips: Vec<Mask>,
    }

    impl<'a> Painter<'a> {
        pub fn new(base: &'a mut [u8], w: u32, h: u32, scale: f32) -> Painter<'a> {
            Painter { base, w, h, scale, layers: Vec::new(), clips: Vec::new() }
        }

        fn tf(&self) -> Transform {
            Transform::from_scale(self.scale, self.scale)
        }

        fn with_target<R>(&mut self, f: impl FnOnce(&mut PixmapMut, Option<&Mask>) -> R) -> Option<R> {
            let (w, h) = (self.w, self.h);
            let clip = self.clips.last();
            if let Some((pm, _)) = self.layers.last_mut() {
                let mut m = pm.as_mut();
                Some(f(&mut m, clip))
            } else {
                let mut m = PixmapMut::from_bytes(self.base, w, h)?;
                Some(f(&mut m, clip))
            }
        }

        fn fill_path(&mut self, path: &Path, paint: &Paint) {
            let tf = self.tf();
            self.with_target(|pm, clip| pm.fill_path(path, paint, FillRule::Winding, tf, clip));
        }

        pub fn rrect(&mut self, x: f32, y: f32, w: f32, h: f32, r: [f32; 4], color: f64) {
            if w <= 0.0 || h <= 0.0 {
                return;
            }
            let mut paint = Paint::default();
            paint.set_color(col(color));
            paint.anti_alias = true;
            if r == [0.0; 4] {
                if let Some(rect) = Rect::from_xywh(x, y, w, h) {
                    let tf = self.tf();
                    self.with_target(|pm, clip| pm.fill_rect(rect, &paint, tf, clip));
                }
                return;
            }
            if let Some(p) = rrect_path(x, y, w, h, r) {
                self.fill_path(&p, &paint);
            }
        }

        pub fn stroke_rrect(&mut self, x: f32, y: f32, w: f32, h: f32, r: [f32; 4], width: f32, color: f64) {
            if w <= 0.0 || h <= 0.0 || width <= 0.0 {
                return;
            }
            let hw = width / 2.0;
            let r2 = [(r[0] - hw).max(0.0), (r[1] - hw).max(0.0), (r[2] - hw).max(0.0), (r[3] - hw).max(0.0)];
            if let Some(p) = rrect_path(x + hw, y + hw, w - width, h - width, r2) {
                let mut paint = Paint::default();
                paint.set_color(col(color));
                paint.anti_alias = true;
                let mut st = Stroke::default();
                st.width = width;
                let tf = self.tf();
                self.with_target(|pm, clip| pm.stroke_path(&p, &paint, &st, tf, clip));
            }
        }

        pub fn lgrad(&mut self, x: f32, y: f32, w: f32, h: f32, r: [f32; 4], angle: f32, stops: &Vec<(f32, f64)>) {
            if w <= 0.0 || h <= 0.0 || stops.is_empty() {
                return;
            }
            let a = angle.to_radians();
            let (dx, dy) = (a.sin(), -a.cos());
            let len = (w * a.sin()).abs() + (h * a.cos()).abs();
            let (cx, cy) = (x + w / 2.0, y + h / 2.0);
            let gs: Vec<GradientStop> = stops.iter().map(|(o, c)| GradientStop::new(*o, col(*c))).collect();
            let sh = LinearGradient::new(
                Point::from_xy(cx - dx * len / 2.0, cy - dy * len / 2.0),
                Point::from_xy(cx + dx * len / 2.0, cy + dy * len / 2.0),
                gs,
                SpreadMode::Pad,
                Transform::identity(),
            );
            if let Some(sh) = sh {
                let mut paint = Paint::default();
                paint.shader = sh;
                paint.anti_alias = true;
                if let Some(p) = rrect_path(x, y, w, h, r) {
                    self.fill_path(&p, &paint);
                }
            }
        }

        pub fn rgrad(&mut self, x: f32, y: f32, w: f32, h: f32, r: [f32; 4], fx: f32, fy: f32, rad: f32, stops: &Vec<(f32, f64)>) {
            if w <= 0.0 || h <= 0.0 || stops.is_empty() {
                return;
            }
            let gs: Vec<GradientStop> = stops.iter().map(|(o, c)| GradientStop::new(*o, col(*c))).collect();
            let c = Point::from_xy(x + w * fx, y + h * fy);
            let sh = RadialGradient::new(c, c, rad.max(0.5), gs, SpreadMode::Pad, Transform::identity());
            if let Some(sh) = sh {
                let mut paint = Paint::default();
                paint.shader = sh;
                paint.anti_alias = true;
                if let Some(p) = rrect_path(x, y, w, h, r) {
                    self.fill_path(&p, &paint);
                }
            }
        }

        fn blit_a8(&mut self, px: i32, py: i32, w: u32, h: u32, a8: &[u8], color: Color, extra: Option<&Mask>) {
            let (sw, sh) = (self.w as i32, self.h as i32);
            let cr = (color.red() * 255.0) as u32;
            let cg = (color.green() * 255.0) as u32;
            let cb = (color.blue() * 255.0) as u32;
            let ca = (color.alpha() * 255.0) as u32;
            let clip_data: Option<Vec<u8>> = self.clips.last().map(|m| m.data().to_vec());
            let extra_data: Option<&[u8]> = extra.map(|m| m.data());
            let wrote = self.with_target(|pm, _| {
                let data = pm.data_mut();
                for yy in 0..h as i32 {
                    let ty = py + yy;
                    if ty < 0 || ty >= sh {
                        continue;
                    }
                    for xx in 0..w as i32 {
                        let tx = px + xx;
                        if tx < 0 || tx >= sw {
                            continue;
                        }
                        let mut cov = a8[(yy as u32 * w + xx as u32) as usize] as u32;
                        if cov == 0 {
                            continue;
                        }
                        let mi = (ty * sw + tx) as usize;
                        if let Some(cd) = &clip_data {
                            cov = cov * cd[mi] as u32 / 255;
                        }
                        if let Some(ed) = extra_data {
                            cov = cov * ed[mi] as u32 / 255;
                        }
                        if cov == 0 {
                            continue;
                        }
                        let ea = ca * cov / 255; // 0..255
                        let i = mi * 4;
                        let inv = 255 - ea;
                        data[i] = ((cr * ea + data[i] as u32 * inv) / 255).min(255) as u8;
                        data[i + 1] = ((cg * ea + data[i + 1] as u32 * inv) / 255).min(255) as u8;
                        data[i + 2] = ((cb * ea + data[i + 2] as u32 * inv) / 255).min(255) as u8;
                        data[i + 3] = ((ea * 255 + data[i + 3] as u32 * inv) / 255).min(255) as u8;
                    }
                }
            });
            let _ = wrote;
        }

        pub fn shadow(&mut self, x: f32, y: f32, w: f32, h: f32, r: [f32; 4], blur: f32, spread: f32, dx: f32, dy: f32, color: f64, inset: bool) {
            let s = self.scale;
            let sigma = (blur * s) / 2.0;
            let margin = (blur * s * 1.6).ceil() as i32 + 2;
            let bx = ((x + dx - spread) * s).floor() as i32;
            let by = ((y + dy - spread) * s).floor() as i32;
            let bw = ((w + 2.0 * spread) * s).ceil() as i32;
            let bh = ((h + 2.0 * spread) * s).ceil() as i32;
            let ox = (x * s).floor() as i32;
            let oy = (y * s).floor() as i32;
            let ow = (w * s).ceil() as i32;
            let oh = (h * s).ceil() as i32;
            let (rx0, ry0, rw, rh) = if inset {
                (ox, oy, ow, oh)
            } else {
                let x0 = bx.min(ox) - margin;
                let y0 = by.min(oy) - margin;
                let x1 = (bx + bw).max(ox + ow) + margin;
                let y1 = (by + bh).max(oy + oh) + margin;
                (x0, y0, x1 - x0, y1 - y0)
            };
            if rw <= 0 || rh <= 0 || rw > 8192 || rh > 8192 {
                return;
            }
            let (rw, rh) = (rw as u32, rh as u32);
            let mut pm = match Pixmap::new(rw, rh) {
                Some(p) => p,
                None => return,
            };
            let mut paint = Paint::default();
            paint.set_color_rgba8(0, 0, 0, 255);
            paint.anti_alias = true;
            let rr = [r[0] + spread, r[1] + spread, r[2] + spread, r[3] + spread];
            let local = Transform::from_translate(-(rx0 as f32), -(ry0 as f32)).pre_scale(s, s);
            if inset {
                pm.fill(Color::from_rgba8(0, 0, 0, 255));
                let mut p2 = Paint::default();
                p2.set_color_rgba8(0, 0, 0, 255);
                p2.blend_mode = BlendMode::Clear;
                p2.anti_alias = true;
                let rr2 = [(r[0] - spread).max(0.0), (r[1] - spread).max(0.0), (r[2] - spread).max(0.0), (r[3] - spread).max(0.0)];
                if let Some(p) = rrect_path(x + dx + spread, y + dy + spread, w - 2.0 * spread, h - 2.0 * spread, rr2) {
                    pm.fill_path(&p, &p2, FillRule::Winding, local, None);
                }
            } else if let Some(p) = rrect_path(x + dx - spread, y + dy - spread, w + 2.0 * spread, h + 2.0 * spread, rr) {
                pm.fill_path(&p, &paint, FillRule::Winding, local, None);
            }
            let mut a8: Vec<u8> = pm.data().chunks(4).map(|p| p[3]).collect();
            gaussian_blur(&mut a8, rw as usize, rh as usize, 1, sigma);
            let mut mk = match Mask::new(self.w, self.h) {
                Some(m) => m,
                None => return,
            };
            let tf = self.tf();
            if let Some(bp) = rrect_path(x, y, w, h, r) {
                if inset {
                    mk.fill_path(&bp, FillRule::Winding, true, tf);
                } else {
                    let mut pb = PathBuilder::new();
                    pb.push_rect(Rect::from_xywh(-10.0, -10.0, self.w as f32 / s + 20.0, self.h as f32 / s + 20.0).unwrap());
                    if let Some(rp) = bp.clone().transform(Transform::identity()) {
                        pb.push_path(&rp);
                    }
                    if let Some(big) = pb.finish() {
                        mk.fill_path(&big, FillRule::EvenOdd, true, tf);
                    }
                }
            }
            self.blit_a8(rx0, ry0, rw, rh, &a8, col(color), Some(&mk));
        }

        pub fn push_clip(&mut self, x: f32, y: f32, w: f32, h: f32, r: [f32; 4]) {
            let mut m = match self.clips.last() {
                Some(prev) => prev.clone(),
                None => {
                    let mut m = Mask::new(self.w, self.h).unwrap();
                    m.data_mut().iter_mut().for_each(|b| *b = 255);
                    m
                }
            };
            let tf = self.tf();
            if let Some(p) = rrect_path(x, y, w.max(0.0), h.max(0.0), r) {
                if self.clips.is_empty() {
                    m.clear();
                    m.fill_path(&p, FillRule::Winding, true, tf);
                } else {
                    m.intersect_path(&p, FillRule::Winding, true, tf);
                }
            } else {
                m.clear();
            }
            self.clips.push(m);
        }

        pub fn pop_clip(&mut self) {
            self.clips.pop();
        }

        pub fn push_layer(&mut self, alpha: f32) {
            if let Some(p) = Pixmap::new(self.w, self.h) {
                self.layers.push((p, alpha));
            }
        }

        pub fn pop_layer(&mut self) {
            if let Some((pm, alpha)) = self.layers.pop() {
                let mut pp = PixmapPaint::default();
                pp.opacity = alpha.clamp(0.0, 1.0);
                self.with_target(|t, _| t.draw_pixmap(0, 0, pm.as_ref(), &pp, Transform::identity(), None));
            }
        }

        pub fn line(&mut self, x1: f32, y1: f32, x2: f32, y2: f32, width: f32, color: f64, round: bool) {
            let mut pb = PathBuilder::new();
            pb.move_to(x1, y1);
            pb.line_to(x2, y2);
            if let Some(p) = pb.finish() {
                let mut paint = Paint::default();
                paint.set_color(col(color));
                paint.anti_alias = true;
                let mut st = Stroke::default();
                st.width = width;
                if round {
                    st.line_cap = LineCap::Round;
                }
                let tf = self.tf();
                self.with_target(|pm, clip| pm.stroke_path(&p, &paint, &st, tf, clip));
            }
        }

        pub fn clear(&mut self, color: f64) {
            let c = col(color);
            self.with_target(|pm, _| pm.fill(c));
        }

        pub fn text(&mut self, x: f32, baseline: f32, size: f32, weight: i64, color: f64, s: &str, ls: f32) {
            let sc = self.scale;
            let size_px = size * sc;
            let colr = col(color);
            let mut pen = x * sc;
            let by = (baseline * sc).round();
            let mut prev: Option<(usize, u16)> = None;
            let mut jobs: Vec<(Rc<Glyph>, i32, i32)> = Vec::new();
            FONTS.with(|fo| {
                let mut fo = fo.borrow_mut();
                if fo.faces.is_empty() {
                    return;
                }
                for c in s.chars() {
                    let (fi, g) = face_for(&mut fo, weight, c);
                    if let Some((pf, pg)) = prev {
                        if pf == fi {
                            pen += kern_pair(&fo.faces[fi], pg, g) * size_px;
                        }
                    }
                    let ipen = pen.floor();
                    let sub = (((pen - ipen) * 4.0) as u8).min(3);
                    if c != ' ' {
                        if let Some(gl) = raster_glyph(&mut fo, fi, g, size_px, sub) {
                            jobs.push((gl, ipen as i32, by as i32));
                        }
                    }
                    let adv = fo.faces[fi].face.glyph_hor_advance(ttf_parser::GlyphId(g)).unwrap_or(0) as f32 / fo.faces[fi].upem;
                    pen += adv * size_px + ls * sc;
                    prev = Some((fi, g));
                }
            });
            for (gl, gx, gy) in jobs {
                if gl.w == 0 {
                    continue;
                }
                self.blit_a8(gx + gl.left, gy + gl.top, gl.w, gl.h, &gl.data, colr, None);
            }
        }

        pub fn icon(&mut self, x: f32, y: f32, size: f32, color: f64, stroke_w: f32, name: &str) {
            let paths: Option<Rc<Vec<Path>>> = FONTS.with(|fo| {
                let mut fo = fo.borrow_mut();
                if let Some(p) = fo.icons.get(name) {
                    return Some(p.clone());
                }
                let src = fo.icon_src.get(name)?.clone();
                let v: Vec<Path> = src.split(';').filter_map(|d| parse_svg_path(d)).collect();
                let rc = Rc::new(v);
                fo.icons.insert(name.to_string(), rc.clone());
                Some(rc)
            });
            let paths = match paths {
                Some(p) => p,
                None => return,
            };
            let k = size / 24.0;
            let mut paint = Paint::default();
            paint.set_color(col(color));
            paint.anti_alias = true;
            let mut st = Stroke::default();
            st.width = stroke_w.max(0.5);
            st.line_cap = LineCap::Round;
            st.line_join = LineJoin::Round;
            let tf = self.tf().pre_translate(x, y).pre_scale(k, k);
            for p in paths.iter() {
                let (pp, stt, t) = (p.clone(), st.clone(), tf);
                let pa = paint.clone();
                self.with_target(|pm, clip| pm.stroke_path(&pp, &pa, &stt, t, clip));
            }
        }

        pub fn svg_path(&mut self, x: f32, y: f32, scale: f32, fill: f64, stroke: f64, stroke_w: f32, d: &str) {
            if let Some(p) = parse_svg_path(d) {
                let tf = self.tf().pre_translate(x, y).pre_scale(scale, scale);
                let fa = (fill as u32) & 255;
                if fa > 0 {
                    let mut paint = Paint::default();
                    paint.set_color(col(fill));
                    paint.anti_alias = true;
                    self.with_target(|pm, clip| pm.fill_path(&p, &paint, FillRule::Winding, tf, clip));
                }
                if (stroke as u32) & 255 > 0 && stroke_w > 0.0 {
                    let mut paint = Paint::default();
                    paint.set_color(col(stroke));
                    paint.anti_alias = true;
                    let mut st = Stroke::default();
                    st.width = stroke_w;
                    st.line_cap = LineCap::Round;
                    st.line_join = LineJoin::Round;
                    self.with_target(|pm, clip| pm.stroke_path(&p, &paint, &st, tf, clip));
                }
            }
        }

        pub fn backdrop(&mut self, x: f32, y: f32, w: f32, h: f32, r: [f32; 4], blur: f32, tint: f64) {
            let s = self.scale;
            let x0 = ((x * s).floor() as i32).max(0);
            let y0 = ((y * s).floor() as i32).max(0);
            let x1 = (((x + w) * s).ceil() as i32).min(self.w as i32);
            let y1 = (((y + h) * s).ceil() as i32).min(self.h as i32);
            if x1 <= x0 || y1 <= y0 {
                return;
            }
            let (rw, rh) = ((x1 - x0) as usize, (y1 - y0) as usize);
            let mut buf = vec![0u8; rw * rh * 4];
            let stride = self.w as usize * 4;
            let src_ok = self.with_target(|pm, _| {
                let d = pm.data_mut();
                for row in 0..rh {
                    let so = (y0 as usize + row) * stride + x0 as usize * 4;
                    buf[row * rw * 4..(row + 1) * rw * 4].copy_from_slice(&d[so..so + rw * 4]);
                }
            });
            if src_ok.is_none() {
                return;
            }
            gaussian_blur(&mut buf, rw, rh, 4, blur * s / 2.0);
            let mut mk = match Mask::new(self.w, self.h) {
                Some(m) => m,
                None => return,
            };
            let tf = self.tf();
            if let Some(p) = rrect_path(x, y, w, h, r) {
                mk.fill_path(&p, FillRule::Winding, true, tf);
            }
            let clip_data: Option<Vec<u8>> = self.clips.last().map(|m| m.data().to_vec());
            let sw = self.w as usize;
            self.with_target(|pm, _| {
                let d = pm.data_mut();
                for row in 0..rh {
                    for cx in 0..rw {
                        let mi = (y0 as usize + row) * sw + x0 as usize + cx;
                        let mut m = mk.data()[mi] as u32;
                        if let Some(cd) = &clip_data {
                            m = m * cd[mi] as u32 / 255;
                        }
                        if m == 0 {
                            continue;
                        }
                        let si = (row * rw + cx) * 4;
                        let di = mi * 4;
                        for k in 0..4 {
                            d[di + k] = ((buf[si + k] as u32 * m + d[di + k] as u32 * (255 - m)) / 255) as u8;
                        }
                    }
                }
            });
            if (tint as u32) & 255 > 0 {
                self.rrect(x, y, w, h, r, tint);
            }
        }
    }

    fn rd(ops: &Vec<f64>, i: &mut usize) -> f64 {
        let v = if *i < ops.len() { ops[*i] } else { 0.0 };
        *i += 1;
        v
    }

    fn rd_stops(ops: &Vec<f64>, i: &mut usize) -> Vec<(f32, f64)> {
        let n = rd(ops, i) as usize;
        let mut v = Vec::with_capacity(n);
        for _ in 0..n {
            let o = rd(ops, i) as f32;
            let c = rd(ops, i);
            v.push((o, c));
        }
        v
    }

    pub fn run_ops(buf: &mut [u8], w: u32, h: u32, scale: f32, ops: &Vec<f64>, strs: &Vec<String>) {
        let mut p = Painter::new(buf, w, h, scale);
        let mut i = 0usize;
        while i < ops.len() {
            let op = ops[i] as i64;
            i += 1;
            match op {
                OP_CLEAR => {
                    let c = rd(ops, &mut i);
                    p.clear(c);
                }
                OP_RRECT => {
                    let (x, y, ww, hh) = (rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32);
                    let r = [rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32];
                    let c = rd(ops, &mut i);
                    p.rrect(x, y, ww, hh, r, c);
                }
                OP_STROKE => {
                    let (x, y, ww, hh) = (rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32);
                    let r = [rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32];
                    let sw = rd(ops, &mut i) as f32;
                    let c = rd(ops, &mut i);
                    p.stroke_rrect(x, y, ww, hh, r, sw, c);
                }
                OP_LGRAD => {
                    let (x, y, ww, hh) = (rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32);
                    let r = [rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32];
                    let ang = rd(ops, &mut i) as f32;
                    let st = rd_stops(ops, &mut i);
                    p.lgrad(x, y, ww, hh, r, ang, &st);
                }
                OP_RGRAD => {
                    let (x, y, ww, hh) = (rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32);
                    let r = [rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32];
                    let (fx, fy, rad) = (rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32);
                    let st = rd_stops(ops, &mut i);
                    p.rgrad(x, y, ww, hh, r, fx, fy, rad, &st);
                }
                OP_SHADOW => {
                    let (x, y, ww, hh) = (rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32);
                    let r = [rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32];
                    let (bl, sp, dx, dy) = (rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32);
                    let c = rd(ops, &mut i);
                    let inset = rd(ops, &mut i) > 0.5;
                    p.shadow(x, y, ww, hh, r, bl, sp, dx, dy, c, inset);
                }
                OP_TEXT => {
                    let (x, y, size) = (rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32);
                    let wt = rd(ops, &mut i) as i64;
                    let c = rd(ops, &mut i);
                    let si = rd(ops, &mut i) as usize;
                    let ls = rd(ops, &mut i) as f32;
                    if si < strs.len() {
                        p.text(x, y, size, wt, c, &strs[si], ls);
                    }
                }
                OP_CLIP => {
                    let (x, y, ww, hh) = (rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32);
                    let r = [rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32];
                    p.push_clip(x, y, ww, hh, r);
                }
                OP_UNCLIP => p.pop_clip(),
                OP_ICON => {
                    let (x, y, size) = (rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32);
                    let c = rd(ops, &mut i);
                    let sw = rd(ops, &mut i) as f32;
                    let si = rd(ops, &mut i) as usize;
                    if si < strs.len() {
                        p.icon(x, y, size, c, sw, &strs[si]);
                    }
                }
                OP_BACKDROP => {
                    let (x, y, ww, hh) = (rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32);
                    let r = [rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32];
                    let bl = rd(ops, &mut i) as f32;
                    let tint = rd(ops, &mut i);
                    p.backdrop(x, y, ww, hh, r, bl, tint);
                }
                OP_LAYER => {
                    let a = rd(ops, &mut i) as f32;
                    p.push_layer(a);
                }
                OP_ENDLAYER => p.pop_layer(),
                OP_LINE => {
                    let (x1, y1, x2, y2) = (rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32);
                    let wd = rd(ops, &mut i) as f32;
                    let c = rd(ops, &mut i);
                    let cap = rd(ops, &mut i) > 0.5;
                    p.line(x1, y1, x2, y2, wd, c, cap);
                }
                OP_PATH => {
                    let (x, y, sc) = (rd(ops, &mut i) as f32, rd(ops, &mut i) as f32, rd(ops, &mut i) as f32);
                    let fill = rd(ops, &mut i);
                    let stroke = rd(ops, &mut i);
                    let sw = rd(ops, &mut i) as f32;
                    let si = rd(ops, &mut i) as usize;
                    if si < strs.len() {
                        p.svg_path(x, y, sc, fill, stroke, sw, &strs[si]);
                    }
                }
                _ => break,
            }
        }
        let _ = MaskType::Alpha;
    }

}

