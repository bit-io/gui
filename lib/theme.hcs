fun theme_tokyo() -> Theme [
    let p = Palette(parse_color("#1a1b26"), parse_color("#1f2335"), parse_color("#292e42"), parse_color("#3b4261"), parse_color("#16161e"), parse_color("#c0caf5"), parse_color("#a9b1d6"), parse_color("#565f89"), parse_color("#7aa2f7"), parse_color("#16161e"), parse_color("#9ece6a"), parse_color("#e0af68"), parse_color("#f7768e"), parse_color("#7dcfff"), rgba(255, 255, 255, 22), rgba(0, 0, 0, 120))
