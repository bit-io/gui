!! Szklany: polprzezroczyste powierzchnie + rozmycie tla (paski, doki, launchery)
fun theme_glass() -> Theme [
    let p = Palette(rgba(24, 24, 37, 150), rgba(30, 30, 46, 140), rgba(255, 255, 255, 22), rgba(255, 255, 255, 40), rgba(17, 17, 27, 190), rgba(236, 240, 255, 255), rgba(200, 206, 230, 230), rgba(170, 176, 205, 170), parse_color("#89b4fa"), parse_color("#11111b"), parse_color("#a6e3a1"), parse_color("#f9e2af"), parse_color("#f38ba8"), parse_color("#74c7ec"), rgba(255, 255, 255, 38), rgba(0, 0, 0, 90))
    end make_theme("glass", p, true, true)
]

fun theme_by_name(n: Str) -> Theme [
    if n == "light" [
        end theme_light()
    ]
    if n == "nord" [
        end theme_nord()
    ]
    if n == "dracula" [
        end theme_dracula()
    ]
    if n == "tokyo" [
        end theme_tokyo()
    ]
    if n == "glass" [
        end theme_glass()
    ]
    end theme_dark()
]
