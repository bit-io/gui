struct Hit [
    id: Str,
    kind: Str,
    sub: Int
]

struct WinState [
    id: Int,
    kind: Str,
    title: Str,
    w: Float,
    h: Float,
    scale: Float,
    ready: Bool,
    closed: Bool,
    clear: Int,
    hover: Str,
    hover_kind: Str,
    sub: Int,
    pressed: Str,
    focus: Str,
    mx: Float,
    my: Float,
    scroll: Dict<Str, Float>,
    anim: Dict<Str, Float>,
    caret: Dict<Str, Int>,
    sel: Dict<Str, Int>,
    edit: Dict<Str, Str>,
    open_pick: Str,
    pick_hover: Int,
    tip: Str,
    tip_cand: Str,
    tip_ms: Int,
    last: Box,
    has_last: Bool,
    dirty: Bool,
    drag: Str,
    cursor: Str,
    active: Bool,
    scroll_to: Dict<Str, Float>
]

struct App [
    backend: Str,
    theme: Theme,
    sheet: Sheet,
    wins: List<WinState>,
    run: Bool,
    main: Int,
    last_ms: Int,
    caret_ms: Int,
    caret_on: Bool,
    force: Bool,
    mods: Int,
    tick_ms: Int,
    last_tick: Int,
    nav_keys: Bool,
    nav_pad: Bool,
    nav_wrap: Bool,
    nav_win: Int,
    pad_lx: Float,
    pad_ly: Float,
    pad_dpad: Int,
    pad_dir: Int,
    pad_next: Int,
    pads: Int,
    tweens: Dict<Str, Float>,
    tween_to: Dict<Str, Float>,
    tween_on: Bool
]

struct EditRes [
    text: Str,
    caret: Int,
    anchor: Int,
    changed: Bool,
    submit: Bool
]

fun win_state_new(id: Int, kind: Str, title: Str, w: Float, h: Float, clear: Int) -> WinState [
    let sc: Dict<Str, Float> = dict()
    let an: Dict<Str, Float> = dict()
    let ca: Dict<Str, Int> = dict()
    let se: Dict<Str, Int> = dict()
    let ed: Dict<Str, Str> = dict()
    let dummy = box_new(el_new("space"), 0.0, 0.0, 0.0, 0.0)
    let st: Dict<Str, Float> = dict()
    end WinState(id, kind, title, w, h, 1.0, false, false, clear, "", "", -1, "", "", 0.0, 0.0, sc, an, ca, se, ed, "", -1, "", "", 0, dummy, false, true, "", "default", false, st)
]

!! ---------------------------------------------------------------- szukanie / trafienia
fun find_box(b: Box, id: Str) -> Option<Box> [
    if b.el.id == id [
        end some(b.clone())
    ]
    let i = 0
    while i < b.kids.len() [
        match find_box(b.kids[i].clone(), id) [
            Some(f) -> [
                end some(f)
            ]
            None -> [
            ]
        ]
        i = i + 1
    ]
    end none()
]

fun is_interactive(e: Element) -> Bool [
    if e.disabled [
        end false
    ]
    if e.kind == "modal" [
        end e.on
    ]
    if e.focusable [
        end true
    ]
    if e.kind == "button" or e.kind == "text_input" or e.kind == "pick_list" or e.kind == "checkbox" or e.kind == "toggler" or e.kind == "radio" or e.kind == "slider" or e.kind == "tabs" [
        end true
    ]
    if e.msg != "" and (e.kind == "container" or e.kind == "row" or e.kind == "column" or e.kind == "stack" or e.kind == "text" or e.kind == "icon") [
        end true
    ]
    end false
]

fun is_focusable(e: Element) -> Bool [
    if e.disabled [
        end false
    ]
    if e.focusable [
        end true
    ]
    end e.kind == "button" or e.kind == "text_input" or e.kind == "pick_list" or e.kind == "checkbox" or e.kind == "toggler" or e.kind == "radio" or e.kind == "slider"
]

fun inside(b: Box, x: Float, y: Float) -> Bool [
    end x >= b.x and x < b.x + b.w and y >= b.y and y < b.y + b.h
]

fun hit_test(b: Box, x: Float, y: Float) -> Hit [
    let none_hit = Hit("", "", -1)
    if not inside(b.clone(), x, y) [
        end none_hit
    ]
    let i = b.kids.len() - 1
    while i >= 0 [
        let h = hit_test(b.kids[i].clone(), x, y)
        if h.id != "" [
            end h
        ]
        i = i - 1
    ]
    if is_interactive(b.el.clone()) [
        let sub = -1
        if b.el.kind == "tabs" [
            let k = 0
            while k < b.el.opts.len() [
                let tx = tab_x(b.clone(), k)
                if x >= tx and x < tx + tab_w(b.clone(), k) [
                    sub = k
                ]
                k = k + 1
            ]
            if sub < 0 [
                end none_hit
            ]
        ]
        end Hit(b.el.id.clone(), b.el.kind.clone(), sub)
    ]
    end none_hit
]

!! id najglebszego scrollable pod punktem
fun hit_scroll(b: Box, x: Float, y: Float) -> Str [
    if not inside(b.clone(), x, y) [
        end ""
    ]
    let i = b.kids.len() - 1
    while i >= 0 [
        let r = hit_scroll(b.kids[i].clone(), x, y)
        if r != "" [
            end r
        ]
        i = i - 1
    ]
    if b.el.kind == "scrollable" or b.el.kind == "vgrid" [
        end b.el.id.clone()
    ]
    end ""
]

fun hit_tip(b: Box, x: Float, y: Float) -> Str [
    if not inside(b.clone(), x, y) [
        end ""
    ]
    let i = 0
    while i < b.kids.len() [
        let r = hit_tip(b.kids[i].clone(), x, y)
        if r != "" [
            end r
        ]
        i = i + 1
    ]
    if b.el.kind == "tooltip" [
        end b.el.id.clone()
    ]
    end ""
]

fun collect_focusable(b: Box, out: List<Str>) [
    if b.el.kind == "modal" and not b.el.on [
        end
    ]
    if is_focusable(b.el.clone()) [
        out.push(b.el.id.clone())
    ]
    let i = 0
    while i < b.kids.len() [
        collect_focusable(b.kids[i].clone(), out)
        i = i + 1
    ]
]

!! cele animacji: h: p: f: t: dla elementow interaktywnych
fun collect_targets(b: Box, hover: Str, sub: Int, pressed: Str, focus: Str, out: Dict<Str, Float>) [
    let e = b.el.clone()
    if e.kind == "modal" [
        let mv = 0.0
        if e.on [
            mv = 1.0
        ]
        out.insert("t:" + e.id, mv)
    ]
    if e.kind == "image" [
        let iv = 0.0
        if gui_image_state(e.img) == 2 [
            iv = 1.0
        ]
        out.insert("i:" + e.id, iv)
    ]
    if is_interactive(e.clone()) or e.kind == "scrollable" or e.kind == "vgrid" [
        let id = e.id.clone()
        let hv = 0.0
        if hover == id [
            hv = 1.0
        ]
        out.insert("h:" + id, hv)
        let pv = 0.0
        if pressed == id and hover == id [
            pv = 1.0
        ]
        out.insert("p:" + id, pv)
        let fv = 0.0
        if focus == id [
            fv = 1.0
        ]
        out.insert("f:" + id, fv)
        if e.kind == "checkbox" or e.kind == "toggler" or e.kind == "radio" [
            let tv = 0.0
            if e.on [
                tv = 1.0
            ]
            out.insert("t:" + id, tv)
        ]
        if e.kind == "tabs" [
            let k = 0
            while k < e.opts.len() [
                let key = id + "#" + (k as Str)
                let h2 = 0.0
                if hover == id and sub == k [
                    h2 = 1.0
                ]
                out.insert("h:" + key, h2)
                let t2 = 0.0
                if (e.v as Int) == k [
                    t2 = 1.0
                ]
                out.insert("t:" + key, t2)
                k = k + 1
            ]
        ]
    ]
    let i = 0
    while i < b.kids.len() [
        collect_targets(b.kids[i].clone(), hover, sub, pressed, focus, out)
        i = i + 1
    ]
]

!! ---------------------------------------------------------------- nawigacja przestrzenna / pulapki fokusu
!! najwyzszy otwarty modal (ostatni w drzewie)
fun find_modal(b: Box) -> Option<Box> [
    if b.el.kind == "modal" [
        if b.el.on [
            end some(b.clone())
        ]
        end none()
    ]
    let i = b.kids.len() - 1
    while i >= 0 [
        match find_modal(b.kids[i].clone()) [
            Some(f) -> [
                end some(f)
            ]
            None -> [
            ]
        ]
        i = i - 1
    ]
    end none()
]

!! pulapka fokusu: otwarty modal lub kontener z `.focus_trap(true)` (ostatni/najglebszy wygrywa)
fun find_trap(b: Box) -> Option<Box> [
    if b.el.kind == "modal" and not b.el.on [
        end none()
    ]
    let i = b.kids.len() - 1
    while i >= 0 [
        match find_trap(b.kids[i].clone()) [
            Some(f) -> [
                end some(f)
            ]
            None -> [
            ]
        ]
        i = i - 1
    ]
    if b.el.trap [
        end some(b.clone())
    ]
    end none()
]

fun focus_scope(root: Box) -> Box [
    match find_trap(root.clone()) [
        Some(t) -> [
            end t
        ]
        None -> [
        ]
    ]
    end root.clone()
]

fun collect_focus_boxes(b: Box, out: List<Box>) [
    if b.el.kind == "modal" and not b.el.on [
        end
    ]
    if is_focusable(b.el.clone()) [
        out.push(b.clone())
    ]
    let i = 0
    while i < b.kids.len() [
        collect_focus_boxes(b.kids[i].clone(), out)
        i = i + 1
    ]
]

!! kierunek: 1 gora, 2 dol, 3 lewo, 4 prawo. Wynik < 0 = nie jest kandydatem. Mniejszy = lepszy.
fun nav_score(cur: Box, c: Box, dir: Int) -> Float [
    let ccx = cur.x + cur.w / 2.0
    let ccy = cur.y + cur.h / 2.0
    let cx = c.x + c.w / 2.0
    let cy = c.y + c.h / 2.0
    let gap = 0.0
    let main = 0.0
    let cross = 0.0
    let overlap = false
    if dir == 2 [
        if cy <= ccy + 1.0 [
            end -1.0
        ]
        gap = fmax(0.0, c.y - (cur.y + cur.h))
        main = cy - ccy
        cross = fabs(cx - ccx)
        overlap = c.x < cur.x + cur.w and c.x + c.w > cur.x
    ]
    if dir == 1 [
        if cy >= ccy - 1.0 [
            end -1.0
        ]
        gap = fmax(0.0, cur.y - (c.y + c.h))
        main = ccy - cy
        cross = fabs(cx - ccx)
        overlap = c.x < cur.x + cur.w and c.x + c.w > cur.x
    ]
    if dir == 4 [
        if cx <= ccx + 1.0 [
            end -1.0
        ]
        gap = fmax(0.0, c.x - (cur.x + cur.w))
        main = cx - ccx
        cross = fabs(cy - ccy)
        overlap = c.y < cur.y + cur.h and c.y + c.h > cur.y
    ]
    if dir == 3 [
        if cx >= ccx - 1.0 [
            end -1.0
        ]
        gap = fmax(0.0, cur.x - (c.x + c.w))
        main = ccx - cx
        cross = fabs(cy - ccy)
        overlap = c.y < cur.y + cur.h and c.y + c.h > cur.y
    ]
    let k = 3.0
    if overlap [
        k = 1.0
    ]
    end gap + main * 0.1 + cross * k
]

!! indeks najlepszego kandydata w kierunku `dir` lub -1
fun spatial_pick(cands: List<Box>, cur: Box, dir: Int) -> Int [
    let best = -1
    let bs = 1000000000.0
    let i = 0
    while i < cands.len() [
        if cands[i].el.id != cur.el.id [
            let sc = nav_score(cur.clone(), cands[i].clone(), dir)
            if sc >= 0.0 and sc < bs [
                bs = sc
                best = i
            ]
        ]
        i = i + 1
    ]
    end best
]

!! lancuch przodkow (scrollable / vgrid) od korzenia do elementu `id`; zwraca true, gdy znaleziono
fun scroll_chain(b: Box, id: Str, out: List<Box>) -> Bool [
    if b.el.id == id [
        end true
    ]
    let i = 0
    while i < b.kids.len() [
        if scroll_chain(b.kids[i].clone(), id, out) [
            if b.el.kind == "scrollable" or b.el.kind == "vgrid" [
                out.push(b.clone())
            ]
            end true
        ]
        i = i + 1
    ]
    end false
]

!! zapisuje (przyciete przez layout) przesuniecia przewijanych kontenerow
fun collect_scrolls(b: Box, out: Dict<Str, Float>) [
    if b.el.kind == "scrollable" or b.el.kind == "vgrid" [
        out.insert(b.el.id.clone(), b.sc)
    ]
    let i = 0
    while i < b.kids.len() [
        collect_scrolls(b.kids[i].clone(), out)
        i = i + 1
    ]
]

fun dir_of_key(name: Str) -> Int [
    if name == "ArrowUp" [
        end 1
    ]
    if name == "ArrowDown" [
        end 2
    ]
    if name == "ArrowLeft" [
        end 3
    ]
    if name == "ArrowRight" [
        end 4
    ]
    end 0
]

fun dir_key(dir: Int) -> Str [
    if dir == 1 [
        end "ArrowUp"
    ]
    if dir == 2 [
        end "ArrowDown"
    ]
    if dir == 3 [
        end "ArrowLeft"
    ]
    end "ArrowRight"
]

!! ---------------------------------------------------------------- edycja tekstu
fun is_word_char(c: Str) -> Bool [
    end c != " " and c != "\n" and c != "\t" and c != "" and c != "," and c != "." and c != ";" and c != ":" and c != "-"
]

fun word_left(t: Str, pos: Int) -> Int [
    let p = pos
    while p > 0 and not is_word_char(t.char_at(p - 1)) [
        p = p - 1
    ]
    while p > 0 and is_word_char(t.char_at(p - 1)) [
        p = p - 1
    ]
    end p
]

fun word_right(t: Str, pos: Int) -> Int [
    let n = slen(t)
    let p = pos
    while p < n and not is_word_char(t.char_at(p)) [
        p = p + 1
    ]
    while p < n and is_word_char(t.char_at(p)) [
        p = p + 1
    ]
    end p
]

fun sel_lo(a: Int, b: Int) -> Int [
    end imin(a, b)
]

fun sel_hi(a: Int, b: Int) -> Int [
    end imax(a, b)
]

!! mods: 1 shift, 2 ctrl, 4 alt, 8 super
fun edit_apply(text: Str, caret: Int, anchor: Int, name: Str, ins: Str, mods: Int) -> EditRes [
    let n = slen(text)
    let c = iclamp(caret, 0, n)
    let a = iclamp(anchor, 0, n)
    let shift = mods % 2 == 1
    let ctrl = (mods / 2) % 2 == 1
    let t = text
    let changed = false
    let submit = false
    let has_sel = c != a
    if name == "Backspace" [
        if has_sel [
            t = t.slice(0, sel_lo(c, a)) + t.slice(sel_hi(c, a), n)
            c = sel_lo(c, a)
            changed = true
        ] else [
            if c > 0 [
                let from = c - 1
                if ctrl [
                    from = word_left(t.clone(), c)
                ]
                t = t.slice(0, from) + t.slice(c, n)
                c = from
                changed = true
            ]
        ]
        a = c
    ] else [
        if name == "Delete" [
            if has_sel [
                t = t.slice(0, sel_lo(c, a)) + t.slice(sel_hi(c, a), n)
                c = sel_lo(c, a)
                changed = true
            ] else [
                if c < n [
                    let to = c + 1
                    if ctrl [
                        to = word_right(t.clone(), c)
                    ]
                    t = t.slice(0, c) + t.slice(to, n)
                    changed = true
                ]
            ]
            a = c
        ] else [
            if name == "ArrowLeft" or name == "ArrowRight" or name == "Home" or name == "End" [
                let np = c
                if name == "ArrowLeft" [
                    if ctrl [
                        np = word_left(t.clone(), c)
                    ] else [
                        if has_sel and not shift [
                            np = sel_lo(c, a)
                        ] else [
                            np = imax(0, c - 1)
                        ]
                    ]
                ]
                if name == "ArrowRight" [
                    if ctrl [
                        np = word_right(t.clone(), c)
                    ] else [
                        if has_sel and not shift [
                            np = sel_hi(c, a)
                        ] else [
                            np = imin(n, c + 1)
                        ]
                    ]
                ]
                if name == "Home" [
                    np = 0
                ]
                if name == "End" [
                    np = n
                ]
                c = np
                if not shift [
                    a = c
                ]
            ] else [
                if name == "Enter" [
                    submit = true
                ] else [
                    if slen(ins) > 0 [
                        if has_sel [
                            t = t.slice(0, sel_lo(c, a)) + t.slice(sel_hi(c, a), n)
                            c = sel_lo(c, a)
                        ]
                        let m = slen(t)
                        t = t.slice(0, c) + ins + t.slice(c, m)
                        c = c + slen(ins)
                        a = c
                        changed = true
                    ]
                ]
            ]
        ]
    ]
    end EditRes(t, c, a, changed, submit)
]

fun caret_from_x(e: Element, text: Str, bx: Float, x: Float) -> Int [
    let n = slen(text)
    let ix = bx + e.st.pl
    let cx = text_prefix_w(e.clone(), text.clone(), n)
    let iw = 0.0
    let target = x - ix
    let i = 0
    let best = 0
    let bestd = 1000000.0
    while i <= n [
        let w = text_prefix_w(e.clone(), text.clone(), i)
        let d = fabs(w - target)
        if d < bestd [
            bestd = d
            best = i
        ]
        i = i + 1
    ]
    end best
]

fun app_new_state(theme: Theme) -> App [
    let ws: List<WinState> = []
    let tw: Dict<Str, Float> = dict()
    let tt: Dict<Str, Float> = dict()
    end App("", theme, sheet_empty(), ws, true, 0, gui_now_ms(), gui_now_ms(), true, true, 0, 0, gui_now_ms(), false, true, false, 0, 0.0, 0.0, 0, 0, 0, 0, tw, tt, false)
]

!! Podstawowy konstruktor: czcionki + backend (auto: Wayland -> X11 -> headless) + glowne okno
fun app_new(title: Str, w: Int, h: Int) -> App [
    end app_new_opts(title, w, h, "toplevel", "")
]

fun app_new_opts(title: Str, w: Int, h: Int, kind: Str, opts: Str) -> App [
    gui_fonts_init(font_regular_b64(), font_semibold_b64(), icon_table())
    let want = gui_env("GUI_BACKEND")
    if want == "" [
        want = "auto"
    ]
    let app = app_new_state(theme_dark())
    app.backend = gui_init(want)
    if app.backend != "headless" [
        gui_pad_enable(1)
    ]
    app.main = app.open_window(kind, title, w, h, opts)
    app.nav_win = app.main
    end app
]

!! Aplikacja bez okna startowego (np. powloka tworzaca same panele)
fun app_new_headless_shell() -> App [
    gui_fonts_init(font_regular_b64(), font_semibold_b64(), icon_table())
    let want = gui_env("GUI_BACKEND")
    if want == "" [
        want = "auto"
    ]
    let app = app_new_state(theme_dark())
    app.backend = gui_init(want)
    if app.backend != "headless" [
        gui_pad_enable(1)
    ]
    end app
]

impl App [
    pub fun running(self) -> Bool [
        end self.run
    ]

    pub fun set_theme(self, t: Theme) [
        self.theme = t
        self.force = true
        let i = 0
        while i < self.wins.len() [
            self.wins[i].dirty = true
            i = i + 1
        ]
    ]

    !! arkusz CSS (patrz gui::css)
    pub fun set_css(self, src: Str) [
        self.sheet = css_parse(src)
        self.force = true
    ]

    pub fun open_window(self, kind: Str, title: Str, w: Int, h: Int, opts: Str) -> Int [
        let id = gui_win_create(kind, title, w, h, opts)
        if id < 0 [
            end -1
        ]
        let clear = self.theme.p.bg
        if kind == "layer" or kind == "popup" [
            clear = 0
        ]
        self.wins.push(win_state_new(id, kind, title, w as Float, h as Float, clear))
        end id
    ]

    pub fun close_window(self, id: Int) [
        gui_win_close(id)
        let keep: List<WinState> = []
        let i = 0
        while i < self.wins.len() [
            if self.wins[i].id != id [
                keep.push(self.wins[i].clone())
            ]
            i = i + 1
        ]
        self.wins = keep
    ]

    pub fun window_ids(self) -> List<Int> [
        let out: List<Int> = []
        let i = 0
        while i < self.wins.len() [
            out.push(self.wins[i].id)
            i = i + 1
        ]
        end out
    ]

    pub fun win_index(self, id: Int) -> Int [
        let i = 0
        while i < self.wins.len() [
            if self.wins[i].id == id [
                end i
            ]
            i = i + 1
        ]
        end -1
    ]

    pub fun win_width(self, id: Int) -> Float [
        let i = self.win_index(id)
        if i >= 0 [
            end self.wins[i].w
        ]
        end 0.0
    ]

    pub fun win_height(self, id: Int) -> Float [
        let i = self.win_index(id)
        if i >= 0 [
            end self.wins[i].h
        ]
        end 0.0
    ]

    pub fun set_title(self, id: Int, t: Str) [
        gui_win_title(id, t)
    ]

    pub fun resize(self, id: Int, w: Int, h: Int) [
        gui_win_resize(id, w, h)
        let i = self.win_index(id)
        if i >= 0 [
            self.wins[i].dirty = true
        ]
    ]

    !! co `ms` milisekund `frame` zwroci Message("tick") (zegary, animacje wlasne); 0 = wylaczone
    pub fun set_tick(self, ms: Int) [
        self.tick_ms = ms
        self.last_tick = gui_now_ms()
    ]

    pub fun request_redraw(self) [
        self.force = true
    ]

    pub fun focus_id(self, win: Int, id: Str) [
        let i = self.win_index(win)
        if i >= 0 [
            self.wins[i].focus = id
            self.wins[i].dirty = true
        ]
    ]

    pub fun quit(self) [
        self.run = false
    ]

    !! rysuje okno `wi` z drzewem `ui`
    pub fun draw_win(self, wi: Int, ui: Element, now: Int) [
        let dt0 = (now - self.last_ms) as Float
        if dt0 > 60.0 [
            dt0 = 60.0
        ]
        if dt0 < 1.0 [
            dt0 = 1.0
        ]
        let sc_active = false
        let skeys = self.wins[wi].scroll_to.keys()
        let q = 0
        while q < skeys.len() [
            let key = skeys[q].clone()
            let tgt = UNSET
            match self.wins[wi].scroll_to.fetch(key.clone()) [
                Some(v) -> [
                    tgt = v
                ]
                None -> [
                ]
            ]
            if tgt != UNSET [
                let cur = 0.0
                match self.wins[wi].scroll.fetch(key.clone()) [
                    Some(v) -> [
                        cur = v
                    ]
                    None -> [
                    ]
                ]
                let nc = cur + (tgt - cur) * fmin(1.0, dt0 / 100.0)
                if fabs(tgt - nc) < 0.5 [
                    nc = tgt
                    self.wins[wi].scroll_to.insert(key.clone(), UNSET)
                ] else [
                    sc_active = true
                ]
                self.wins[wi].scroll.insert(key, nc)
            ]
            q = q + 1
        ]
        let ctx = Ctx(self.theme.clone(), self.sheet.clone(), self.wins[wi].hover.clone(), self.wins[wi].pressed.clone(), self.wins[wi].focus.clone())
        let root = resolve_el(ui, ctx, "@")
        let box = layout_root(root, self.wins[wi].w, self.wins[wi].h, self.wins[wi].scroll.clone())
        self.wins[wi].last = box.clone()
        self.wins[wi].has_last = true
        let fixed: Dict<Str, Float> = dict()
        collect_scrolls(box.clone(), fixed)
        let fks = fixed.keys()
        let fq = 0
        while fq < fks.len() [
            let fid = fks[fq].clone()
            let fv = 0.0
            match fixed.fetch(fid.clone()) [
                Some(v) -> [
                    fv = v
                ]
                None -> [
                ]
            ]
            let fcur = 0.0
            match self.wins[wi].scroll.fetch(fid.clone()) [
                Some(v) -> [
                    fcur = v
                ]
                None -> [
                ]
            ]
            if fabs(fcur - fv) > 0.01 [
                self.wins[wi].scroll.insert(fid.clone(), fv)
                self.wins[wi].scroll_to.insert(fid.clone(), UNSET)
            ]
            fq = fq + 1
        ]
        let targets: Dict<Str, Float> = dict()
        collect_targets(box.clone(), self.wins[wi].hover.clone(), self.wins[wi].sub, self.wins[wi].pressed.clone(), self.wins[wi].focus.clone(), targets)
        let dt = (now - self.last_ms) as Float
        if dt > 60.0 [
            dt = 60.0
        ]
        if dt < 1.0 [
            dt = 1.0
        ]
        let step = dt / self.theme.anim_ms
        let active = false
        let keys = targets.keys()
        let k = 0
        while k < keys.len() [
            let key = keys[k].clone()
            let tv = 0.0
            match targets.fetch(key.clone()) [
                Some(v) -> [
                    tv = v
                ]
                None -> [
                ]
            ]
            let cur = tv
            let have = false
            match self.wins[wi].anim.fetch(key.clone()) [
                Some(v) -> [
                    cur = v
                    have = true
                ]
                None -> [
                ]
            ]
            if have and fabs(cur - tv) > 0.001 [
                if cur < tv [
                    cur = fmin(tv, cur + step)
                ] else [
                    cur = fmax(tv, cur - step)
                ]
                active = true
            ]
            self.wins[wi].anim.insert(key, cur)
            k = k + 1
        ]
        self.wins[wi].active = active or sc_active
        let show_tip = ""
        if self.wins[wi].tip != "" [
            show_tip = self.wins[wi].tip.clone()
        ]
        let rc = RCtx(self.theme.clone(), self.wins[wi].hover.clone(), self.wins[wi].pressed.clone(), self.wins[wi].focus.clone(), self.wins[wi].anim.clone(), self.wins[wi].caret.clone(), self.wins[wi].sel.clone(), self.wins[wi].open_pick.clone(), show_tip, self.caret_on, self.wins[wi].mx, self.wins[wi].my, self.wins[wi].w, self.wins[wi].h, self.wins[wi].pick_hover)
        let clr = self.theme.p.bg
        if self.wins[wi].kind == "layer" or self.wins[wi].kind == "popup" [
            clr = 0
        ]
        let ops = render_scene(box, rc, clr)
        let st = gui_win_draw(self.wins[wi].id, ops.f, ops.s)
        if st == 0 [
            self.wins[wi].dirty = false
        ] else [
            self.wins[wi].dirty = true
        ]
    ]

    pub fun pending_wait(self, now: Int) -> Int [
        let t = -1
        let i = 0
        while i < self.wins.len() [
            let w = self.wins[i].clone()
            if w.dirty or w.active [
                t = 8
            ]
            if w.focus != "" [
                let rem = 530 - (now - self.caret_ms)
                if rem < 1 [
                    rem = 1
                ]
                if t < 0 or rem < t [
                    t = rem
                ]
            ]
            if w.tip_cand != "" and w.tip == "" [
                let rem2 = 450 - (now - w.tip_ms)
                if rem2 < 1 [
                    rem2 = 1
                ]
                if t < 0 or rem2 < t [
                    t = rem2
                ]
            ]
            i = i + 1
        ]
        if self.pad_dir != 0 [
            let rem4 = self.pad_next - now
            if rem4 < 1 [
                rem4 = 1
            ]
            if t < 0 or rem4 < t [
                t = rem4
            ]
        ]
        if self.tween_on [
            if t < 0 or t > 8 [
                t = 8
            ]
        ]
        if self.tick_ms > 0 [
            let rem3 = self.tick_ms - (now - self.last_tick)
            if rem3 < 1 [
                rem3 = 1
            ]
            if t < 0 or rem3 < t [
                t = rem3
            ]
        ]
        end t
    ]

    !! glowny krok: `uis` w kolejnosci `window_ids()`
    pub fun frame(self, uis: List<Element>) -> List<Message> [
        let out: List<Message> = []
        let now = gui_now_ms()
        let i = 0
        while i < self.wins.len() [
            if i < uis.len() and self.wins[i].ready [
                if self.wins[i].dirty or self.force or self.wins[i].active [
                    self.draw_win(i, uis[i].clone(), now)
                    self.wins[i].edit = dict()
                ]
            ]
            i = i + 1
        ]
        self.last_ms = now
        self.force = false
        let timeout = self.pending_wait(now)
        let evs = gui_poll(timeout)
        let e = 0
        while e < evs.len() [
            self.handle_event(evs[e].clone(), out)
            e = e + 1
        ]
        let now2 = gui_now_ms()
        if now2 - self.caret_ms >= 530 [
            self.caret_ms = now2
            self.caret_on = not self.caret_on
            let j = 0
            while j < self.wins.len() [
                if self.wins[j].focus != "" [
                    self.wins[j].dirty = true
                ]
                j = j + 1
            ]
        ]
        let j2 = 0
        while j2 < self.wins.len() [
            if self.wins[j2].tip_cand != "" and self.wins[j2].tip == "" and now2 - self.wins[j2].tip_ms >= 450 [
                self.wins[j2].tip = self.wins[j2].tip_cand.clone()
                self.wins[j2].dirty = true
            ]
            j2 = j2 + 1
        ]
        if self.pad_dir != 0 and now2 >= self.pad_next [
            self.pad_next = now2 + 110
            self.nav_move(self.pad_dir, out)
        ]
        if self.tween_on [
            self.step_tweens((now2 - now) as Float)
        ]
        if self.tick_ms > 0 and now2 - self.last_tick >= self.tick_ms [
            self.last_tick = now2
            out.push(self.mk_msg("tick", 0))
        ]
        if out.len() > 0 [
            self.force = true
        ]
        end out
    ]

    pub fun frame1(self, ui: Element) -> List<Message> [
        let l: List<Element> = [ui]
        end self.frame(l)
    ]

    pub fun reset_caret(self) [
        self.caret_ms = gui_now_ms()
        self.caret_on = true
    ]

    pub fun mk_msg(self, id: Str, win: Int) -> Message [
        let m = message(id)
        m.win = win
        end m
    ]

    !! zwraca 0 lub 1 komunikat (kompilator nie propaguje &mut przez wywolania metod, wiec bez parametru `out`)
    pub fun activate(self, wi: Int, b: Box) -> List<Message> [
        let res: List<Message> = []
        let e = b.el.clone()
        let win = self.wins[wi].id
        if e.msg != "" [
            let m = self.mk_msg(e.msg.clone(), win)
            m.text = e.text.clone()
            if e.kind == "checkbox" or e.kind == "toggler" [
                m.flag = not e.on
            ]
            if e.kind == "radio" [
                m.flag = true
            ]
            res.push(m)
        ]
        end res
    ]

    !! obejscie dla funkcji pomocniczych przyjmujacych `app`: kompilator uznaje parametr za mutowany dopiero po
    !! wywolaniu metody o nazwie jak wbudowane mutatory (clear/insert/push...) - wywolaj `app.clear()` w takiej funkcji
    pub fun clear(self) [
        self.force = true
    ]

    pub fun slider_value(self, b: Box, x: Float) -> Float [
        let e = b.el.clone()
        let kr = 8.0
        let ratio = fclamp((x - (b.x + kr)) / fmax(1.0, b.w - 2.0 * kr), 0.0, 1.0)
        let v = e.vmin + ratio * (e.vmax - e.vmin)
        if e.step > 0.0 [
            v = fround(v / e.step) * e.step
            v = fclamp(v, e.vmin, e.vmax)
        ]
        end v
    ]

    pub fun update_hover(self, wi: Int) [
        if not self.wins[wi].has_last [
            end
        ]
        let w = self.wins[wi].clone()
        let h = hit_test(w.last.clone(), w.mx, w.my)
        if w.open_pick != "" [
            match find_box(w.last.clone(), w.open_pick.clone()) [
                Some(pb) -> [
                    let rh = pick_row_h()
                    let lw = pick_list_w(pb.clone())
                    let n = pb.el.opts.len()
                    let lh = rh * (n as Float) + 8.0
                    let ly = pb.y + pb.h + 4.0
                    if ly + lh > w.h - 4.0 [
                        ly = pb.y - lh - 4.0
                    ]
                    let row = -1
                    if w.mx >= pb.x and w.mx < pb.x + lw and w.my >= ly + 4.0 and w.my < ly + 4.0 + rh * (n as Float) [
                        row = ((w.my - ly - 4.0) / rh) as Int
                    ]
                    if row != w.pick_hover [
                        self.wins[wi].pick_hover = row
                        self.wins[wi].dirty = true
                    ]
                    if row >= 0 [
                        h = Hit("", "", -1)
                    ]
                ]
                None -> [
                ]
            ]
        ]
        if h.id != w.hover or h.sub != w.sub [
            self.wins[wi].hover = h.id.clone()
            self.wins[wi].hover_kind = h.kind.clone()
            self.wins[wi].sub = h.sub
            self.wins[wi].dirty = true
            let cur = "default"
            if h.kind == "text_input" [
                cur = "text"
            ]
            if h.kind == "button" or h.kind == "checkbox" or h.kind == "toggler" or h.kind == "radio" or h.kind == "pick_list" or h.kind == "tabs" or h.kind == "slider" [
                cur = "pointer"
            ]
            if h.kind == "container" or h.kind == "row" or h.kind == "column" or h.kind == "stack" or h.kind == "text" or h.kind == "icon" [
                cur = "pointer"
            ]
            if cur != w.cursor [
                self.wins[wi].cursor = cur.clone()
                gui_cursor(cur)
            ]
        ]
        let tip = hit_tip(w.last.clone(), w.mx, w.my)
        if tip != w.tip_cand [
            self.wins[wi].tip_cand = tip.clone()
            self.wins[wi].tip_ms = gui_now_ms()
            if w.tip != "" [
                self.wins[wi].tip = ""
                self.wins[wi].dirty = true
            ]
        ]
    ]

    pub fun handle_event(self, line: Str, out: List<Message>) [
        if gui_env("GUI_DEBUG") != "" [
            log("gui-event", line)
        ]
        let p = s_split(line, "\t")
        let kind = p[0].clone()
        let wid = -1
        if p.len() > 1 [
            wid = parse_i(p[1].clone())
        ]
        if kind == "output" or kind == "toplevel" or kind == "toplevel_closed" or kind == "lock" or kind == "idle" or kind == "clip_changed" [
            let m = self.mk_msg(kind.clone(), 0)
            m.args = p.clone()
            if kind == "toplevel" and p.len() >= 5 [
                m.idx = parse_i(p[1].clone())
                m.text = p[2].clone()
                m.text2 = p[3].clone()
                m.text3 = p[4].clone()
            ]
            if kind == "toplevel_closed" and p.len() >= 2 [
                m.idx = parse_i(p[1].clone())
            ]
            if kind == "output" and p.len() >= 7 [
                m.text = p[1].clone()
                m.args = p.clone()
            ]
            if kind == "lock" and p.len() >= 2 [
                m.text = p[1].clone()
            ]
            if kind == "idle" and p.len() >= 3 [
                m.idx = parse_i(p[1].clone())
                m.flag = p[2] == "1"
            ]
            out.push(m)
            end
        ]
        if kind == "image" [
            let k2 = 0
            while k2 < self.wins.len() [
                self.wins[k2].dirty = true
                k2 = k2 + 1
            ]
            end
        ]
        if kind == "msg" and p.len() >= 7 [
            let m = self.mk_msg(p[6].clone(), 0)
            let pl = gui_msg_take(parse_i(p[2].clone()))
            m.text = pl[0].clone()
            m.text2 = pl[1].clone()
            m.text3 = pl[2].clone()
            m.num = parse_f(p[3].clone())
            m.idx = parse_i(p[4].clone())
            m.flag = p[5] == "1"
            out.push(m)
            end
        ]
        if kind == "pad" and p.len() >= 6 [
            self.handle_pad(p[2].clone(), parse_i(p[3].clone()), p[4].clone(), parse_f(p[5].clone()), out)
            end
        ]
        let wi = self.win_index(wid)
        if wi < 0 [
            end
        ]
        if kind == "resize" and p.len() >= 5 [
            let nw = parse_f(p[2].clone())
            let nh = parse_f(p[3].clone())
            let ns = parse_f(p[4].clone())
            let changed = nw != self.wins[wi].w or nh != self.wins[wi].h or ns != self.wins[wi].scale
            self.wins[wi].w = nw
            self.wins[wi].h = nh
            self.wins[wi].scale = ns
            self.wins[wi].dirty = true
            if changed [
                let m = self.mk_msg("resize", wid)
                m.num = nw
                m.args = ["", p[2].clone(), p[3].clone()]
                out.push(m)
            ]
        ]
        if kind == "ready" [
            self.wins[wi].ready = true
            self.wins[wi].dirty = true
        ]
        if kind == "expose" [
            self.wins[wi].dirty = true
        ]
        if kind == "close" [
            self.wins[wi].closed = true
            let m = self.mk_msg("close", wid)
            out.push(m)
            if wid == self.main [
                self.run = false
            ]
        ]
        if kind == "focus" and p.len() >= 3 [
            if p[2] == "0" [
                self.wins[wi].pressed = ""
                self.wins[wi].drag = ""
            ]
            self.wins[wi].dirty = true
        ]
        if kind == "ptr_leave" [
            self.wins[wi].hover = ""
            self.wins[wi].hover_kind = ""
            self.wins[wi].sub = -1
            self.wins[wi].tip_cand = ""
            self.wins[wi].tip = ""
            self.wins[wi].dirty = true
        ]
        if (kind == "ptr_move" or kind == "touch_move") and p.len() >= 4 [
            let xi = 2
            if kind == "touch_move" [
                xi = 3
            ]
            self.wins[wi].mx = parse_f(p[xi].clone())
            self.wins[wi].my = parse_f(p[xi + 1].clone())
            self.pointer_move(wi, out)
        ]
        if (kind == "ptr_down" or kind == "touch_down") and p.len() >= 5 [
            let bi = 0
            let xi = 3
            if kind == "touch_down" [
                xi = 3
            ] else [
                bi = parse_i(p[2].clone())
            ]
            self.wins[wi].mx = parse_f(p[xi].clone())
            self.wins[wi].my = parse_f(p[xi + 1].clone())
            self.update_hover(wi)
            if bi == 0 [
                self.pointer_down(wi, out)
            ]
        ]
        if (kind == "ptr_up" or kind == "touch_up") and p.len() >= 4 [
            self.pointer_up(wi, out)
        ]
        if kind == "scroll" and p.len() >= 6 [
            let dy = parse_f(p[3].clone())
            let dx = parse_f(p[2].clone())
            let mx = parse_f(p[4].clone())
            let my = parse_f(p[5].clone())
            self.wins[wi].mx = mx
            self.wins[wi].my = my
            if self.wins[wi].has_last [
                let sid = hit_scroll(self.wins[wi].last.clone(), mx, my)
                if sid != "" [
                    let cur = 0.0
                    match self.wins[wi].scroll.fetch(sid.clone()) [
                        Some(v) -> [
                            cur = v
                        ]
                        None -> [
                        ]
                    ]
                    let amount = dy * 2.0
                    match find_box(self.wins[wi].last.clone(), sid.clone()) [
                        Some(sb) -> [
                            if sb.el.axis == 1 and fabs(dx) > 0.01 [
                                amount = dx * 2.0
                            ]
                        ]
                        None -> [
                        ]
                    ]
                    self.wins[wi].scroll.insert(sid.clone(), cur + amount)
                    self.wins[wi].scroll_to.insert(sid, UNSET)
                    self.wins[wi].dirty = true
                ]
            ]
        ]
        if kind == "key" and p.len() >= 7 [
            self.key_event(wi, p, out)
        ]
    ]

    pub fun pointer_move(self, wi: Int, out: List<Message>) [
        let w = self.wins[wi].clone()
        if w.drag != "" and w.has_last [
            if s_starts(w.drag.clone(), "sel:") [
                let id = s_sub(w.drag.clone(), 4, slen(w.drag.clone()))
                match find_box(w.last.clone(), id.clone()) [
                    Some(b) -> [
                        let t = self.edit_text(wi, b.el.clone())
                        let c = caret_from_x(b.el.clone(), t.clone(), b.x, w.mx)
                        self.wins[wi].caret.insert(id, c)
                        self.wins[wi].dirty = true
                    ]
                    None -> [
                    ]
                ]
            ] else [
                match find_box(w.last.clone(), w.drag.clone()) [
                    Some(b) -> [
                        if b.el.kind == "slider" [
                            let v = self.slider_value(b.clone(), w.mx)
                            let m = self.mk_msg(b.el.msg.clone(), w.id)
                            m.num = v
                            if b.el.msg != "" and fabs(v - b.el.v) > 0.00001 [
                                out.push(m)
                            ]
                        ]
                    ]
                    None -> [
                    ]
                ]
            ]
        ]
        self.update_hover(wi)
    ]

    pub fun edit_text(self, wi: Int, e: Element) -> Str [
        match self.wins[wi].edit.fetch(e.id.clone()) [
            Some(t) -> [
                end t
            ]
            None -> [
            ]
        ]
        end e.text.clone()
    ]

    pub fun pointer_down(self, wi: Int, out: List<Message>) [
        let w = self.wins[wi].clone()
        if not w.has_last [
            end
        ]
        self.reset_caret()
        if w.open_pick != "" [
            match find_box(w.last.clone(), w.open_pick.clone()) [
                Some(pb) -> [
                    if w.pick_hover >= 0 and w.pick_hover < pb.el.opts.len() [
                        let m = self.mk_msg(pb.el.msg.clone(), w.id)
                        m.text = pb.el.opts[w.pick_hover].clone()
                        m.idx = w.pick_hover
                        if pb.el.msg != "" [
                            out.push(m)
                        ]
                    ]
                ]
                None -> [
                ]
            ]
            self.wins[wi].open_pick = ""
            self.wins[wi].dirty = true
            end
        ]
        let h = hit_test(w.last.clone(), w.mx, w.my)
        self.wins[wi].pressed = h.id.clone()
        self.wins[wi].dirty = true
        if h.id == "" [
            self.wins[wi].focus = ""
            end
        ]
        match find_box(w.last.clone(), h.id.clone()) [
            Some(b) -> [
                let k = b.el.kind.clone()
                if k == "text_input" [
                    self.wins[wi].focus = h.id.clone()
                    let t = self.edit_text(wi, b.el.clone())
                    let c = caret_from_x(b.el.clone(), t.clone(), b.x, w.mx)
                    self.wins[wi].caret.insert(h.id.clone(), c)
                    self.wins[wi].sel.insert(h.id.clone(), c)
                    self.wins[wi].drag = "sel:" + h.id
                ]
                if k == "slider" [
                    self.wins[wi].focus = h.id.clone()
                    self.wins[wi].drag = h.id.clone()
                    let v = self.slider_value(b.clone(), w.mx)
                    if b.el.msg != "" [
                        let m = self.mk_msg(b.el.msg.clone(), w.id)
                        m.num = v
                        out.push(m)
                    ]
                ]
                if k == "pick_list" [
                    self.wins[wi].focus = h.id.clone()
                    self.wins[wi].open_pick = h.id.clone()
                    self.wins[wi].pick_hover = -1
                ]
                if k == "tabs" and h.sub >= 0 [
                    if b.el.msg != "" [
                        let m = self.mk_msg(b.el.msg.clone(), w.id)
                        m.idx = h.sub
                        m.text = b.el.opts[h.sub].clone()
                        out.push(m)
                    ]
                ]
                if k == "checkbox" or k == "toggler" or k == "radio" [
                    self.wins[wi].focus = ""
                ]
                if k == "button" [
                    self.wins[wi].focus = ""
                ]
                if b.el.focusable and k != "text_input" and k != "button" [
                    self.wins[wi].focus = h.id.clone()
                ]
                self.nav_win = w.id
            ]
            None -> [
            ]
        ]
    ]

    pub fun pointer_up(self, wi: Int, out: List<Message>) [
        let w = self.wins[wi].clone()
        let pressed = w.pressed.clone()
        self.wins[wi].pressed = ""
        self.wins[wi].drag = ""
        self.wins[wi].dirty = true
        if pressed == "" or not w.has_last [
            end
        ]
        let h = hit_test(w.last.clone(), w.mx, w.my)
        if h.id == pressed [
            match find_box(w.last.clone(), pressed.clone()) [
                Some(b) -> [
                    let k = b.el.kind.clone()
                    if k == "modal" [
                        let outside = true
                        if b.kids.len() > 0 [
                            outside = not inside(b.kids[0].clone(), w.mx, w.my)
                        ]
                        if outside [
                            for am in self.activate(wi, b.clone()) [
                                out.push(am)
                            ]
                        ]
                    ]
                    if k == "button" or k == "checkbox" or k == "toggler" or k == "radio" or k == "container" or k == "row" or k == "column" or k == "stack" or k == "text" or k == "icon" [
                        for am in self.activate(wi, b.clone()) [
                            out.push(am)
                        ]
                    ]
                ]
                None -> [
                ]
            ]
        ]
    ]

    pub fun key_event(self, wi: Int, p: List<Str>, out: List<Message>) [
        let down = p[2] == "1"
        let name = p[4].clone()
        let text = p[5].clone()
        text = s_replace(s_replace(text.clone(), "\\t", "\t"), "\\n", "\n")
        let mods = parse_i(p[6].clone())
        self.mods = mods
        if not down [
            end
        ]
        self.reset_caret()
        let w = self.wins[wi].clone()
        if not w.has_last [
            end
        ]
        !! HWDE: klawisze nawigacyjne trafiaja tez do aplikacji, gdy fokus ma widget (np. pole szukania launchera)
        if w.focus != "" and (name == "Escape" or name == "ArrowUp" or name == "ArrowDown" or name == "PageUp" or name == "PageDown") [
            let km = self.mk_msg("key", w.id)
            km.text = name.clone()
            km.text2 = text.clone()
            km.idx = mods
            out.push(km)
        ]
        let ctrl = (mods / 2) % 2 == 1
        let shift = mods % 2 == 1
        self.nav_win = w.id
        if name == "Escape" [
            if w.open_pick == "" [
                match find_modal(w.last.clone()) [
                    Some(mb) -> [
                        if mb.el.msg != "" [
                            out.push(self.mk_msg(mb.el.msg.clone(), w.id))
                        ]
                        end
                    ]
                    None -> [
                    ]
                ]
            ]
            if w.open_pick != "" [
                self.wins[wi].open_pick = ""
            ] else [
                self.wins[wi].focus = ""
            ]
            self.wins[wi].dirty = true
            end
        ]
        if name == "Tab" [
            let ids: List<Str> = []
            collect_focusable(focus_scope(w.last.clone()), ids)
            if ids.len() > 0 [
                let cur = -1
                let i = 0
                while i < ids.len() [
                    if ids[i] == w.focus [
                        cur = i
                    ]
                    i = i + 1
                ]
                let nx = 0
                if shift [
                    nx = cur - 1
                    if nx < 0 [
                        nx = ids.len() - 1
                    ]
                ] else [
                    nx = cur + 1
                    if nx >= ids.len() [
                        nx = 0
                    ]
                ]
                self.wins[wi].focus = ids[nx].clone()
                self.wins[wi].open_pick = ""
                self.wins[wi].dirty = true
            ]
            end
        ]
        if self.nav_keys and dir_of_key(name.clone()) > 0 [
            let consume = true
            if w.focus != "" [
                match find_box(w.last.clone(), w.focus.clone()) [
                    Some(fb) -> [
                        let fk = fb.el.kind.clone()
                        let nd = dir_of_key(name.clone())
                        if fk == "text_input" [
                            consume = false
                        ]
                        if fk == "slider" and nd > 2 [
                            consume = false
                        ]
                        if fk == "pick_list" and w.open_pick == fb.el.id [
                            consume = false
                        ]
                    ]
                    None -> [
                    ]
                ]
            ]
            if consume [
                self.nav_move(dir_of_key(name.clone()), out)
                end
            ]
        ]
        if w.focus == "" [
            let m = self.mk_msg("key", w.id)
            m.text = name
            m.text2 = text
            m.idx = mods
            out.push(m)
            end
        ]
        match find_box(w.last.clone(), w.focus.clone()) [
            Some(b) -> [
                let e = b.el.clone()
                if e.kind == "text_input" [
                    self.edit_key(wi, b.clone(), name.clone(), text.clone(), mods, out)
                ]
                if e.kind == "button" or e.kind == "checkbox" or e.kind == "toggler" or e.kind == "radio" or (e.focusable and e.kind != "text_input" and e.kind != "slider" and e.kind != "pick_list") [
                    if name == "Enter" or name == "Space" [
                        for am in self.activate(wi, b.clone()) [
                            out.push(am)
                        ]
                    ]
                ]
                if e.kind == "slider" [
                    let stp = e.step
                    if stp <= 0.0 [
                        stp = (e.vmax - e.vmin) / 20.0
                    ]
                    let nv = e.v
                    if name == "ArrowLeft" or name == "ArrowDown" [
                        nv = fmax(e.vmin, e.v - stp)
                    ]
                    if name == "ArrowRight" or name == "ArrowUp" [
                        nv = fmin(e.vmax, e.v + stp)
                    ]
                    if name == "Home" [
                        nv = e.vmin
                    ]
                    if name == "End" [
                        nv = e.vmax
                    ]
                    if nv != e.v and e.msg != "" [
                        let m = self.mk_msg(e.msg.clone(), w.id)
                        m.num = nv
                        out.push(m)
                    ]
                ]
                if e.kind == "pick_list" [
                    let n = e.opts.len()
                    if name == "Enter" or name == "Space" [
                        if w.open_pick == e.id [
                            if w.pick_hover >= 0 and w.pick_hover < n and e.msg != "" [
                                let m = self.mk_msg(e.msg.clone(), w.id)
                                m.text = e.opts[w.pick_hover].clone()
                                m.idx = w.pick_hover
                                out.push(m)
                            ]
                            self.wins[wi].open_pick = ""
                        ] else [
                            self.wins[wi].open_pick = e.id.clone()
                            self.wins[wi].pick_hover = 0
                        ]
                    ]
                    if name == "ArrowDown" or name == "ArrowUp" [
                        if w.open_pick == e.id [
                            let nh = w.pick_hover
                            if name == "ArrowDown" [
                                nh = imin(n - 1, nh + 1)
                            ] else [
                                nh = imax(0, nh - 1)
                            ]
                            self.wins[wi].pick_hover = nh
                        ]
                    ]
                ]
                self.wins[wi].dirty = true
            ]
            None -> [
            ]
        ]
    ]

    pub fun edit_key(self, wi: Int, b: Box, name: Str, text: Str, mods: Int, out: List<Message>) [
        let e = b.el.clone()
        let w = self.wins[wi].clone()
        let cur = self.edit_text(wi, e.clone())
        let n = slen(cur.clone())
        let caret = n
        match self.wins[wi].caret.fetch(e.id.clone()) [
            Some(v) -> [
                caret = v
            ]
            None -> [
            ]
        ]
        let anchor = caret
        match self.wins[wi].sel.fetch(e.id.clone()) [
            Some(v) -> [
                anchor = v
            ]
            None -> [
            ]
        ]
        let ctrl = (mods / 2) % 2 == 1
        let ins = text
        let nm = name
        if ctrl [
            ins = ""
            if name == "a" or name == "A" [
                caret = n
                anchor = 0
                nm = ""
            ]
            if name == "c" or name == "C" or name == "x" or name == "X" [
                if caret != anchor [
                    let lo = imin(caret, anchor)
                    let hi = imax(caret, anchor)
                    gui_clip_set(s_sub(cur.clone(), lo, hi))
                ]
                if name == "x" or name == "X" [
                    nm = "Delete"
                ] else [
                    nm = ""
                ]
            ]
            if name == "v" or name == "V" [
                let clip = gui_clip_get()
                ins = s_replace(s_replace(clip.clone(), "\n", " "), "\r", "")
                nm = ""
            ]
        ]
        if name == "Tab" [
            ins = ""
        ]
        if name == "Enter" [
            ins = ""
        ]
        let r = edit_apply(cur.clone(), caret, anchor, nm, ins, mods)
        self.wins[wi].caret.insert(e.id.clone(), r.caret)
        self.wins[wi].sel.insert(e.id.clone(), r.anchor)
        if r.changed [
            self.wins[wi].edit.insert(e.id.clone(), r.text.clone())
            if e.msg != "" [
                let m = self.mk_msg(e.msg.clone(), w.id)
                m.text = r.text.clone()
                m.idx = r.caret
                out.push(m)
            ]
        ]
        if r.submit and e.msg2 != "" [
            let m = self.mk_msg(e.msg2.clone(), w.id)
            m.text = r.text.clone()
            out.push(m)
        ]
        self.wins[wi].dirty = true
    ]

    !! ================================================================ nawigacja / gamepad / przewijanie / animacje
    pub fun set_key_nav(self, on: Bool) [
        self.nav_keys = on
    ]

    pub fun set_pad_nav(self, on: Bool) [
        self.nav_pad = on
    ]

    pub fun set_nav_wrap(self, on: Bool) [
        self.nav_wrap = on
    ]

    pub fun enable_gamepad(self, on: Bool) [
        if on [
            gui_pad_enable(1)
        ] else [
            gui_pad_enable(0)
        ]
    ]

    pub fun focused(self, win: Int) -> Str [
        let i = self.win_index(win)
        if i >= 0 [
            end self.wins[i].focus.clone()
        ]
        end ""
    ]

    !! przenosi fokus na `b`, przewija tak, by byl widoczny, i wysyla komunikat "focus" (text = id)
    pub fun set_focus(self, wi: Int, b: Box, out: List<Message>) [
        let w = self.wins[wi].clone()
        self.wins[wi].focus = b.el.id.clone()
        self.wins[wi].open_pick = ""
        self.wins[wi].dirty = true
        self.reset_caret()
        let chain: List<Box> = []
        scroll_chain(w.last.clone(), b.el.id.clone(), chain)
        let ci = 0
        while ci < chain.len() [
            let a = chain[ci].clone()
            let m = 14.0
            let delta = 0.0
            if a.el.axis == 1 [
                let lo = a.x + a.el.st.pl + m
                let hi = a.x + a.w - a.el.st.pr - m
                if b.x < lo [
                    delta = b.x - lo
                ]
                if b.x + b.w > hi [
                    delta = b.x + b.w - hi
                ]
            ] else [
                let lo = a.y + a.el.st.pt + m
                let hi = a.y + a.h - a.el.st.pb - m
                if b.y < lo [
                    delta = b.y - lo
                ]
                if b.y + b.h > hi [
                    delta = b.y + b.h - hi
                ]
            ]
            if delta != 0.0 [
                let base = a.sc
                match self.wins[wi].scroll_to.fetch(a.el.id.clone()) [
                    Some(v) -> [
                        if v != UNSET [
                            base = v
                        ]
                    ]
                    None -> [
                    ]
                ]
                self.wins[wi].scroll_to.insert(a.el.id.clone(), fmax(0.0, base + delta))
            ]
            ci = ci + 1
        ]
        let fm = self.mk_msg("focus", w.id)
        fm.text = b.el.id.clone()
        out.push(fm)
    ]

    !! ruch fokusu w kierunku (1 gora, 2 dol, 3 lewo, 4 prawo); respektuje pulapki fokusu
    pub fun nav_move(self, dir: Int, out: List<Message>) [
        if false [
            out.push(self.mk_msg("", 0))
        ]
        let wi = self.win_index(self.nav_win)
        if wi < 0 [
            wi = self.win_index(self.main)
        ]
        if wi < 0 [
            end
        ]
        if not self.wins[wi].has_last [
            end
        ]
        let w = self.wins[wi].clone()
        let cands: List<Box> = []
        collect_focus_boxes(focus_scope(w.last.clone()), cands)
        if cands.len() == 0 [
            end
        ]
        let cur = -1
        let i = 0
        while i < cands.len() [
            if cands[i].el.id == w.focus [
                cur = i
            ]
            i = i + 1
        ]
        if cur < 0 [
            self.set_focus(wi, cands[0].clone(), out)
            end
        ]
        let ck = cands[cur].el.kind.clone()
        if ck == "slider" and dir > 2 [
            self.key_event(wi, ["key", (w.id as Str), "1", "0", dir_key(dir), "", "0"], out)
            end
        ]
        if ck == "pick_list" and w.open_pick == cands[cur].el.id [
            self.key_event(wi, ["key", (w.id as Str), "1", "0", dir_key(dir), "", "0"], out)
            end
        ]
        if ck == "text_input" and dir > 2 [
            self.key_event(wi, ["key", (w.id as Str), "1", "0", dir_key(dir), "", "0"], out)
            end
        ]
        let best = spatial_pick(cands.clone(), cands[cur].clone(), dir)
        if best < 0 and self.nav_wrap [
            let k = 0
            let far = -1
            let fs = -1.0
            while k < cands.len() [
                let opp = 1
                if dir == 1 [
                    opp = 2
                ]
                if dir == 3 [
                    opp = 4
                ]
                if dir == 4 [
                    opp = 3
                ]
                let sc = nav_score(cands[cur].clone(), cands[k].clone(), opp)
                if sc >= 0.0 and sc > fs [
                    fs = sc
                    far = k
                ]
                k = k + 1
            ]
            best = far
        ]
        if best >= 0 [
            self.set_focus(wi, cands[best].clone(), out)
        ]
    ]

    pub fun nav_activate(self, out: List<Message>) [
        if false [
            out.push(self.mk_msg("", 0))
        ]
        let wi = self.win_index(self.nav_win)
        if wi < 0 [
            wi = self.win_index(self.main)
        ]
        if wi < 0 [
            end
        ]
        if self.wins[wi].focus == "" [
            self.nav_move(2, out)
            end
        ]
        self.key_event(wi, ["key", (self.wins[wi].id as Str), "1", "0", "Enter", "", "0"], out)
    ]

    pub fun nav_back(self, out: List<Message>) [
        let wi = self.win_index(self.nav_win)
        if wi < 0 [
            wi = self.win_index(self.main)
        ]
        if wi < 0 [
            end
        ]
        let w = self.wins[wi].clone()
        if w.open_pick != "" [
            self.wins[wi].open_pick = ""
            self.wins[wi].dirty = true
            end
        ]
        if w.has_last [
            match find_modal(w.last.clone()) [
                Some(mb) -> [
                    if mb.el.msg != "" [
                        out.push(self.mk_msg(mb.el.msg.clone(), w.id))
                    ]
                    end
                ]
                None -> [
                ]
            ]
        ]
        out.push(self.mk_msg("back", w.id))
    ]

    pub fun pad_direction(self) -> Int [
        if self.pad_dpad % 2 == 1 [
            end 1
        ]
        if (self.pad_dpad / 2) % 2 == 1 [
            end 2
        ]
        if (self.pad_dpad / 4) % 2 == 1 [
            end 3
        ]
        if (self.pad_dpad / 8) % 2 == 1 [
            end 4
        ]
        if fabs(self.pad_lx) > 0.55 or fabs(self.pad_ly) > 0.55 [
            if fabs(self.pad_ly) >= fabs(self.pad_lx) [
                if self.pad_ly < 0.0 [
                    end 1
                ]
                end 2
            ]
            if self.pad_lx < 0.0 [
                end 3
            ]
            end 4
        ]
        end 0
    ]

    pub fun pad_dir_changed(self, out: List<Message>) [
        if false [
            out.push(self.mk_msg("", 0))
        ]
        let nd = self.pad_direction()
        if nd != self.pad_dir [
            self.pad_dir = nd
            if nd != 0 and self.nav_pad [
                self.nav_move(nd, out)
                self.pad_next = gui_now_ms() + 380
            ]
            if nd == 0 [
                self.pad_next = 0
            ]
        ]
    ]

    !! zdarzenia gamepada z warstwy natywnej -> Message (pad_button / pad_axis / pad_connected / pad_disconnected)
    !! + opcjonalna nawigacja (D-pad i lewa galka = ruch fokusu, A = Enter, B = wstecz / zamkniecie modala)
    pub fun handle_pad(self, kind: Str, pid: Int, name: Str, val: Float, out: List<Message>) [
        if kind == "connected" [
            self.pads = self.pads + 1
            let m = self.mk_msg("pad_connected", 0)
            m.text = name
            m.idx = pid
            out.push(m)
            end
        ]
        if kind == "disconnected" [
            self.pads = imax(0, self.pads - 1)
            self.pad_dpad = 0
            self.pad_lx = 0.0
            self.pad_ly = 0.0
            self.pad_dir = 0
            let m2 = self.mk_msg("pad_disconnected", 0)
            m2.idx = pid
            out.push(m2)
            end
        ]
        if kind == "button" [
            let down = val > 0.5
            let m3 = self.mk_msg("pad_button", 0)
            m3.text = name
            m3.idx = pid
            m3.flag = down
            m3.num = val
            out.push(m3)
            let bit = 0
            if name == "Up" [
                bit = 1
            ]
            if name == "Down" [
                bit = 2
            ]
            if name == "Left" [
                bit = 4
            ]
            if name == "Right" [
                bit = 8
            ]
            if bit > 0 [
                let has = (self.pad_dpad / bit) % 2 == 1
                if down and not has [
                    self.pad_dpad = self.pad_dpad + bit
                ]
                if (not down) and has [
                    self.pad_dpad = self.pad_dpad - bit
                ]
                self.pad_dir_changed(out)
            ]
            if down and self.nav_pad [
                if name == "A" [
                    self.nav_activate(out)
                ]
                if name == "B" [
                    self.nav_back(out)
                ]
            ]
            end
        ]
        if kind == "axis" [
            let m4 = self.mk_msg("pad_axis", 0)
            m4.text = name
            m4.idx = pid
            m4.num = val
            out.push(m4)
            if name == "lx" [
                self.pad_lx = val
                self.pad_dir_changed(out)
            ]
            if name == "ly" [
                self.pad_ly = val
                self.pad_dir_changed(out)
            ]
        ]
    ]

    !! natychmiastowe ustawienie przewiniecia
    pub fun scroll_set(self, win: Int, id: Str, offset: Float) [
        let i = self.win_index(win)
        if i >= 0 [
            self.wins[i].scroll.insert(id.clone(), offset)
            self.wins[i].scroll_to.insert(id, UNSET)
            self.wins[i].dirty = true
        ]
    ]

    !! animowane przewiniecie do `offset`
    pub fun scroll_to(self, win: Int, id: Str, offset: Float) [
        let i = self.win_index(win)
        if i >= 0 [
            self.wins[i].scroll_to.insert(id, fmax(0.0, offset))
            self.wins[i].dirty = true
        ]
    ]

    pub fun scroll_offset(self, win: Int, id: Str) -> Float [
        let i = self.win_index(win)
        if i >= 0 [
            match self.wins[i].scroll.fetch(id) [
                Some(v) -> [
                    end v
                ]
                None -> [
                ]
            ]
        ]
        end 0.0
    ]

    !! przewija (animowanie) tak, by element `index` wirtualnej siatki/listy `id` byl na srodku widoku
    pub fun scroll_to_item(self, win: Int, id: Str, index: Int) [
        let i = self.win_index(win)
        if i < 0 or not self.wins[i].has_last [
            end
        ]
        match find_box(self.wins[i].last.clone(), id.clone()) [
            Some(b) -> [
                let e = b.el.clone()
                let lines = imax(1, b.cols)
                let item_main = e.item_h
                let view = b.h
                if e.axis == 1 [
                    item_main = e.item_w
                    view = b.w
                ]
                let step = item_main + e.st.gap
                let line = index / lines
                let target = (line as Float) * step - (view - item_main) / 2.0
                self.scroll_to(win, id, fmax(0.0, target))
            ]
            None -> [
            ]
        ]
    ]

    !! zakres widocznych elementow wirtualnej siatki (pionowej): [first, koniec(wylacznie), kolumny]; z buforem 1 wiersza
    pub fun vrange(self, win: Int, id: Str, count: Int, item_w: Float, item_h: Float, gap: Float, cols: Int) -> List<Int> [
        let i = self.win_index(win)
        let vw = 0.0
        let vh = 0.0
        let off = 0.0
        if i >= 0 [
            vw = self.wins[i].w
            vh = self.wins[i].h
            if self.wins[i].has_last [
                match find_box(self.wins[i].last.clone(), id.clone()) [
                    Some(b) -> [
                        vw = b.w
                        vh = b.h
                    ]
                    None -> [
                    ]
                ]
            ]
            match self.wins[i].scroll.fetch(id.clone()) [
                Some(v) -> [
                    off = v
                ]
                None -> [
                ]
            ]
        ]
        let lines = cols
        if lines <= 0 [
            lines = imax(1, ((vw + gap) / (item_w + gap)) as Int)
        ]
        let step = fmax(1.0, item_h + gap)
        let fl = imax(0, ((off / step) as Int) - 2)
        let ll = ((off + vh) / step) as Int + 2
        let first = imin(count, fl * lines)
        let last = imin(count, (ll + 1) * lines)
        end [first, last, lines]
    ]

    !! animowana wartosc: przesuwa sie ku `target` (staly czas ~120 ms); wywolaj w widoku, uzyj wyniku np. w .offset()/.scale()
    pub fun tween(self, key: Str, target: Float) -> Float [
        let cur = target
        match self.tweens.fetch(key.clone()) [
            Some(v) -> [
                cur = v
            ]
            None -> [
            ]
        ]
        if fabs(cur - target) > 0.001 [
            self.tween_on = true
        ]
        self.tween_to.insert(key.clone(), target)
        self.tweens.insert(key, cur)
        end cur
    ]

    pub fun step_tweens(self, dt: Float) [
        let any = false
        let keys = self.tween_to.keys()
        let i = 0
        while i < keys.len() [
            let k = keys[i].clone()
            let tgt = 0.0
            match self.tween_to.fetch(k.clone()) [
                Some(v) -> [
                    tgt = v
                ]
                None -> [
                ]
            ]
            let cur = tgt
            match self.tweens.fetch(k.clone()) [
                Some(v) -> [
                    cur = v
                ]
                None -> [
                ]
            ]
            if fabs(tgt - cur) > 0.001 [
                cur = cur + (tgt - cur) * fmin(1.0, fmax(dt, 1.0) / 120.0)
                if fabs(tgt - cur) <= 0.001 [
                    cur = tgt
                ] else [
                    any = true
                ]
                self.tweens.insert(k, cur)
            ]
            i = i + 1
        ]
        self.tween_on = any
        let j = 0
        while j < self.wins.len() [
            self.wins[j].dirty = true
            j = j + 1
        ]
    ]

    !! ---- zadania w tle (wynik wraca jako Message o podanym `id`; patrz gui_task_*)
    pub fun post(self, id: Str, text: Str) [
        gui_inject_message(id, text, "", "", 0.0, 0, 0)
    ]

    pub fun task_run(self, id: Str, cmd: Str, args: List<Str>) [
        gui_task_run(id, cmd, args)
    ]

    pub fun task_http_get(self, id: Str, url: Str) [
        let h: List<Str> = []
        gui_task_http(id, "GET", url, h, "", 20)
    ]

    pub fun task_scan(self, id: Str, roots: List<Str>, suffixes: List<Str>, depth: Int) [
        gui_task_scan(id, roots, suffixes, depth)
    ]

    pub fun task_after(self, id: Str, ms: Int) [
        gui_task_after(id, ms)
    ]

    pub fun task_cancel(self, id: Str) [
        gui_task_cancel(id)
    ]
]
